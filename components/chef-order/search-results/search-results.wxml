      <!-- 搜索结果蒙版 -->
      <view wx:if="{{searchArr !== null}}" class="search-mask" bindtap="cancel">
        <view class="search-result-list" catchtap="noop">
          <view wx:if="{{searchArr.length > 0}}">
            <view class="p-10" wx:for="{{searchArr}}" wx:for-item="order" wx:key="nxDepartmentOrdersId">
              <view class="flex flex-row-between border-bottom p-10">
                <view class="flex font-md">
                  <text class="mr-10">{{order.globalOrderIndex || ''}}</text>
                  <view class="flex-cloumn" style="width: {{windowWidth - 200}}rpx; ">
                    <view class="flex-row-wrap align-center">
                      <text class="brand" wx:if="{{order.nxDistributerGoodsEntity && order.nxDistributerGoodsEntity.nxDgGoodsBrand !== 'null' && order.nxDistributerGoodsEntity.nxDgGoodsBrand.length > 0}}">{{order.nxDistributerGoodsEntity.nxDgGoodsBrand}}</text>
                      <text class="font-bold mr-10">{{order.nxDistributerGoodsEntity.nxDgGoodsName}}</text>
                      <text class="font-sm" wx:if="{{order.nxDistributerGoodsEntity && order.nxDistributerGoodsEntity.nxDgGoodsPlace !== 'null' && order.nxDistributerGoodsEntity.nxDgGoodsPlace.length > 0}}">({{order.nxDistributerGoodsEntity.nxDgGoodsPlace}})</text>
                      <text class="font-sm" wx:if="{{order.nxDistributerGoodsEntity && order.nxDistributerGoodsEntity.nxDgGoodsDetail.length > 0 && order.nxDistributerGoodsEntity.nxDgGoodsDetail !==  'null'}}">{{order.nxDistributerGoodsEntity.nxDgGoodsDetail}}</text>
                      <text class="mr-20">({{order.nxDoPrintStandard}})</text>
                      <text class="">订:{{order.nxDoQuantity}}{{order.nxDoStandard}}</text>
                      <text class="text-danger font-sl" wx:if="{{order.nxDoRemark !== null  && order.nxDoRemark.length > 0}}">({{order.nxDoRemark}})</text>
                    </view>
                    <view class="flex flex-row font-sl" wx:if="{{depInfo.nxDepartmentSettleType == 0}}">
                      <view class="third-row">
                        <text class="text-secondary">出货:</text>
                        <text class="" wx:if="{{order.nxDoWeight !== null}}">{{order.nxDoWeight}}{{order.nxDoPrintStandard}}</text>
                      </view>
                      <view class="third-row">
                        <text class=" text-secondary">单价:</text>
                        <text class="" wx:if="{{order.nxDoPrice !== null}}">{{order.nxDoPrice}}/{{order.nxDoPrintStandard}}</text>
                      </view>
                      <view class="third-row" wx:if="{{order.nxDoSubtotal !== null || order.nxDoSubtotal == ''}}">
                        <text class="text-secondary">小计:</text>
                        <text class="">{{order.nxDoSubtotal}}元</text>
                      </view>
                    </view>
                  </view>
                </view>
                <view class="p-10" wx:if="{{order.nxDoPurchaseStatus == 4}}" >
                  待配送
                </view>
                <view class="p-10" wx:elif="{{order.nxDoPurchaseStatus == 5}}" bindtap="receive">
                  已收货
                </view>
                <view wx:else="" class="button-container-white" catch:tap="edit" data-order="{{order}}" data-subname="" data-id="{{order.nxDistributerGoodsEntity.nxDistributerGoodsId}}" data-name="{{order.nxDistributerGoodsEntity.nxDgGoodsName}}" data-type="goods" data-color="{{order.nxDistributerGoodsEntity.nxDgNxGoodsFatherColor}}" data-goods="{{order.nxDistributerGoodsEntity}}" hover-class="hover">
                  <image src="/images/edit.png" class="icon"></image>
                </view>
              </view>
            </view>
          </view>
          <view wx:else class="search-no-result">
            <view class="flex-column-center" style="height: 300rpx;">
              <view class="flex-column-center">
                <view>
                  <image src="/images/search.png" mode="aspectFill" class="url_item" style="width: 80rpx; height: 80rpx; opacity: 0.5;" />
                </view>
                <view class="font-bold font-lg-2 p-20">
                  <text>没有搜索到订单</text>
                </view>
                <view>
                  <text>请尝试其他关键词</text>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>
