/* 蒙版 */
.popup-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.35);
  z-index: 1000;
}

/* 弹出层容器 */
.popup-container {
  position: fixed;
  left: 50%; top: 40%;
  transform: translate(-50%, -50%);
  background: #fff;
  border-radius: 32rpx;
  box-shadow: 0 8rpx 40rpx rgba(0,0,0,0.18);
  width: 600rpx;
  max-width: 90vw;
  z-index: 1001;
  padding: 0 0 40rpx 0;
  animation: fadeIn 0.3s;
}

/* 头部样式 */
.popup-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 36rpx 40rpx 0 40rpx;
}

.popup-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #222;
  letter-spacing: 2rpx;
}

.close-icon {
  width: 40rpx;
  height: 40rpx;
  opacity: 0.6;
}

/* 内容区域 */
.popup-content {
  padding: 32rpx 48rpx 0 48rpx;
}
.form-group {
  margin-bottom: 40rpx;
}

/* 单选按钮样式 */
.radio-option {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  margin: 8rpx 0;
  border: 2rpx solid #e5e5e5;
  border-radius: 12rpx;
  background: #fafbfc;
  transition: all 0.3s ease;
  cursor: pointer;
  width: fit-content;
  min-width: 200rpx;
}

.radio-option.selected {
  border-color: #07c160;
  background: #f0f9f4;
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.15);
}

.radio-option1 {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  margin: 8rpx 0;
  border: 2rpx solid #e5e5e5;
  border-radius: 12rpx;
  background: #fafbfc;
  transition: all 0.3s ease;
  cursor: pointer;
  width: 100%;
  max-width: 300rpx;
}

.radio-option1.selected {
  border-color: #07c160;
  background: #f0f9f4;
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.15);
}

.radio-circle {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #ddd;
  border-radius: 50%;
  margin-left: 16rpx;
  position: relative;
  transition: all 0.3s ease;
  flex-shrink: 0;
}

.radio-circle.checked {
  border-color: #07c160;
  background-color: #07c160;
  transform: scale(1.1);
}

.radio-circle.checked::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 18rpx;
  height: 18rpx;
  background-color: white;
  border-radius: 50%;
}

/* 表单布局样式 */
.flex-row-default {
  display: flex;
  align-items: flex-start;
  margin-bottom: 32rpx;
  gap: 20rpx;
}

.flex-fixed {
  flex-shrink: 0;
}

.flex-column {
  display: flex;
  flex-direction: column;
  flex: 1;
  gap: 12rpx;
}

.font-md {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
}

.form-label {
  font-size: 34rpx;
  color: #666;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.department-picker {
  border: 2rpx solid #e5e5e5;
  border-radius: 16rpx;
  padding: 24rpx 32rpx;
  font-size: 32rpx;
  color: #333;
  background: #fafbfc;
  transition: all 0.3s ease;
}

.department-picker:focus {
  border-color: #07c160;
  background: #f0f9f4;
}

.department-picker1 {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 2rpx solid #e5e5e5;
  border-radius: 16rpx;
  padding: 2rpx 32rpx;
  font-size: 32rpx;
  color: #333;
  background: #fafbfc;
  transition: all 0.3s ease;
  min-height: 90rpx;
}

.department-picker1:focus {
  border-color: #07c160;
  background: #f0f9f4;
}

.picker-arrow-img {
  width: 32rpx;
  height: 32rpx;
  margin-left: 16rpx;
  opacity: 0.6;
  transition: all 0.3s ease;
}

.ava {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #dbdbdb;
  display: flex;
  /* align-items: center; */
  /* justify-content: center; */
  margin: 0 auto 8rpx auto;
  border: 2rpx solid #e5e5e5;
}
.avaImg {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  object-fit: cover;
}
.avatar-tip {
  color: #fa5151;
  font-size: 24rpx;
  margin-top: 8rpx;
}
.inputName {
  width: 100%;
  border: none;
  border-bottom: 2rpx solid #e5e5e5;
  background: transparent;
  font-size: 32rpx;
  padding: 12rpx 0;
}
.inputName:focus {
  border-bottom: 2rpx solid #07c160;
}
.save-btn{
  text-align: center;
  line-height: 60rpx;
  border-radius: 20rpx;
  padding: 10rpx 0;
  background-color: rgb(218, 218, 218);
}
.save-btn.next {
  background-color: #07c160;
  color: rgb(248, 248, 248);

}









/* 动画效果 */
@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes scaleIn {
  from {
    transform: scale(0.95);
  }
  to {
    transform: scale(1);
  }
}

/* 响应式设计 */
@media (max-width: 750rpx) {
  .radio-option,
  .radio-option1 {
    padding: 20rpx 24rpx;
    margin: 8rpx 0;
  }

  .department-picker1 {
    padding: 20rpx 24rpx;
  }

  .font-md {
    font-size: 28rpx;
  }
}

/* 交互反馈 */
.radio-option:active,
.radio-option1:active {
  transform: scale(0.98);
  transition: transform 0.1s ease;
}

.department-picker1:active {
  transform: scale(0.98);
  transition: transform 0.1s ease;
}

/* 表单组样式优化 */
.form-group {
  margin-bottom: 40rpx;
  animation: fadeIn 0.3s ease;
}

/* 标签样式优化 */
.form-label {
  font-size: 34rpx;
  color: #666;
  margin-bottom: 16rpx;
  font-weight: 500;
  display: block;
}
