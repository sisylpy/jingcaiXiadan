.mask { position: fixed; inset: 0; z-index: 90; background: rgba(10, 24, 17, .48); }
.sheet { position: fixed; z-index: 91; left: 0; right: 0; bottom: 0; max-height: 88vh; background: #f5f7f6; border-radius: 28rpx 28rpx 0 0; color: #17251f; overflow: hidden; }
.sheet.standalone { top: 0; max-height: none; display: flex; flex-direction: column; box-sizing: border-box; border-radius: 0; }
.sheet.inline { position: relative; z-index: 1; right: auto; bottom: auto; left: auto; width: 100%; max-width: 100%; max-height: none; box-sizing: border-box; border: 1rpx solid #e1e9e4; border-radius: 19rpx; overflow: hidden; }
.sheet-head { height: 92rpx; padding: 0 28rpx; display: flex; align-items: center; justify-content: space-between; background: #fff; border-bottom: 1rpx solid #e8eeea; }
.standalone-head { flex: none; justify-content: flex-start; }
.sheet-back { width: 56rpx; height: 56rpx; margin-right: 8rpx; color: #247050; font-size: 52rpx; font-weight: 300; line-height: 48rpx; text-align: center; }
.standalone-subtitle { margin-top: 5rpx; color: #7b8881; font-size: 21rpx; }
.sheet-title { font-size: 32rpx; font-weight: 700; }
.sheet-close { width: 56rpx; height: 56rpx; color: #718078; font-size: 42rpx; line-height: 52rpx; text-align: center; }
.sheet-scroll { width: 100%; max-height: calc(88vh - 190rpx); padding: 18rpx 24rpx 30rpx; box-sizing: border-box; overflow-x: hidden; }
.sheet.standalone .sheet-scroll { height: 0; max-height: none; flex: 1; }
.sheet.inline .sheet-scroll { height: auto; max-height: none; overflow: visible; }
.field, .note-field, .switch-row { background: #fff; border-radius: 16rpx; padding: 0 22rpx; margin-bottom: 12rpx; }
.field { min-height: 82rpx; display: flex; align-items: center; justify-content: space-between; gap: 18rpx; }
.field-label { color: #4f5f56; font-size: 26rpx; }
.field input { width: 0; min-width: 0; flex: 1; text-align: right; font-size: 27rpx; }
.address-field { align-items: flex-start; padding-top: 18rpx; padding-bottom: 18rpx; }
.address-controls { width: 0; min-width: 0; display: flex; flex: 1; flex-direction: column; align-items: flex-end; }
.address-controls input { width: 100%; }
.map-button { margin-top: 13rpx; padding: 9rpx 18rpx; color: #176846; background: #eaf7f0; border-radius: 24rpx; font-size: 22rpx; }
.location-summary { margin: -2rpx 0 12rpx; padding: 16rpx 22rpx; display: flex; align-items: center; justify-content: space-between; color: #246648; background: #eaf7f0; border-radius: 14rpx; font-size: 22rpx; }
.visit-photo-block { margin-bottom: 12rpx; padding: 22rpx; background: #fff; border-radius: 16rpx; }
.visit-photo-head { margin-bottom: 15rpx; display: flex; align-items: center; justify-content: space-between; }
.visit-photo-title { color: #4f5f56; font-size: 26rpx; }
.visit-photo-count { color: #87928c; font-size: 22rpx; }
.visit-photo-grid { width: 100%; min-width: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12rpx; }
.visit-photo-item { position: relative; min-width: 0; }
.visit-photo { width: 100%; height: 178rpx; display: block; background: #edf2ef; border-radius: 12rpx; }
.visit-photo-unavailable { height: 178rpx; display: flex; align-items: center; justify-content: center; color: #8a958f; background: #edf2ef; border-radius: 12rpx; font-size: 21rpx; }
.visit-photo-empty { height: 174rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #527265; background: #f3f7f5; border: 2rpx dashed #cbdad2; border-radius: 12rpx; font-size: 21rpx; }
.visit-photo-empty text:first-child { margin-bottom: 5rpx; font-size: 38rpx; line-height: 1; }
.photo-remove { position: absolute; top: -9rpx; right: -9rpx; width: 38rpx; height: 38rpx; color: #fff; background: #b05c50; border-radius: 50%; font-size: 30rpx; line-height: 34rpx; text-align: center; }
.photo-gap-note { margin-top: 12rpx; color: #9b6a2e; font-size: 20rpx; line-height: 1.5; }
.picker-value { color: #26372e; font-size: 27rpx; }
.block-title { margin: 24rpx 4rpx 14rpx; font-size: 27rpx; font-weight: 650; }
.option-grid { display: grid; gap: 12rpx; }
.result-grid { grid-template-columns: repeat(3, 1fr); }
.intent-grid { grid-template-columns: repeat(3, 1fr); }
.feedback-grid { grid-template-columns: repeat(3, 1fr); }
.return-customer { padding: 24rpx; border-radius: 17rpx; background: #fff; }
.return-name { font-size: 32rpx; font-weight: 700; }
.return-address { margin-top: 9rpx; color: #78867e; font-size: 23rpx; }
.return-summary { margin-top: 12rpx; padding: 8rpx 22rpx; border-radius: 16rpx; background: #fff; }
.return-summary > view { min-height: 62rpx; display: flex; align-items: center; justify-content: space-between; border-bottom: 1rpx solid #edf1ef; font-size: 23rpx; }
.return-summary > view:last-child { border-bottom: 0; }
.return-summary text:first-child { color: #738078; }
.return-summary text:last-child { max-width: 470rpx; overflow: hidden; color: #293a31; text-align: right; text-overflow: ellipsis; white-space: nowrap; }
.option { min-height: 68rpx; display: flex; align-items: center; justify-content: center; border: 1rpx solid #dce5e0; border-radius: 14rpx; background: #fff; color: #536159; font-size: 25rpx; }
.option.selected { border-color: #77b493; background: #eaf7f0; color: #176846; font-weight: 650; }
.switch-row { min-height: 82rpx; display: flex; align-items: center; justify-content: space-between; margin-top: 22rpx; font-size: 27rpx; }
.follow-arrange-note { margin: -2rpx 0 18rpx; padding: 16rpx 18rpx; border-radius: 13rpx; color: #557064; background: #edf6f1; font-size: 22rpx; line-height: 1.45; }
.announcement-block { margin-bottom: 14rpx; }
.announcement-switch { margin-top: 0; padding-top: 15rpx; padding-bottom: 15rpx; }
.announcement-title { color: #26372e; font-size: 27rpx; }
.announcement-note { margin-top: 7rpx; color: #87928c; font-size: 21rpx; }
.contact-toggle { padding: 20rpx 4rpx; color: #176846; font-size: 26rpx; font-weight: 600; }
.note-field { padding-top: 20rpx; }
.note-field textarea { width: 100%; height: 116rpx; margin-top: 14rpx; font-size: 26rpx; }
.sheet-actions { width: 100%; display: flex; gap: 16rpx; padding: 14rpx 24rpx 24rpx; box-sizing: border-box; background: #fff; border-top: 1rpx solid #e5ebe7; }
.sheet.standalone .sheet-actions { flex: none; padding-bottom: calc(24rpx + env(safe-area-inset-bottom)); }
.sheet-actions button { flex: 1; height: 76rpx; line-height: 76rpx; border-radius: 38rpx; font-size: 28rpx; }
.cancel { background: #f0f3f1; color: #526159; }
.save { background: #20704e; color: #fff; }
