.mask { position: fixed; inset: 0; z-index: 90; background: rgba(10, 24, 17, .48); }
.sheet { position: fixed; z-index: 91; left: 0; right: 0; bottom: 0; max-height: 88vh; background: #f5f7f6; border-radius: 28rpx 28rpx 0 0; color: #17251f; overflow: hidden; }
.sheet-head { height: 92rpx; padding: 0 28rpx; display: flex; align-items: center; justify-content: space-between; background: #fff; border-bottom: 1rpx solid #e8eeea; }
.sheet-title { font-size: 32rpx; font-weight: 700; }
.sheet-close { width: 56rpx; height: 56rpx; color: #718078; font-size: 42rpx; line-height: 52rpx; text-align: center; }
.sheet-scroll { max-height: calc(88vh - 190rpx); padding: 18rpx 24rpx 30rpx; box-sizing: border-box; }
.field, .note-field, .switch-row { background: #fff; border-radius: 16rpx; padding: 0 22rpx; margin-bottom: 12rpx; }
.field { min-height: 82rpx; display: flex; align-items: center; justify-content: space-between; }
.field-label { color: #4f5f56; font-size: 26rpx; }
.field input { width: 430rpx; text-align: right; font-size: 27rpx; }
.address-field { align-items: flex-start; padding-top: 18rpx; padding-bottom: 18rpx; }
.address-controls { width: 470rpx; display: flex; flex-direction: column; align-items: flex-end; }
.address-controls input { width: 100%; }
.map-button { margin-top: 13rpx; padding: 9rpx 18rpx; color: #176846; background: #eaf7f0; border-radius: 24rpx; font-size: 22rpx; }
.location-summary { margin: -2rpx 0 12rpx; padding: 16rpx 22rpx; display: flex; align-items: center; justify-content: space-between; color: #246648; background: #eaf7f0; border-radius: 14rpx; font-size: 22rpx; }
.visit-photo-block { margin-bottom: 12rpx; padding: 22rpx; background: #fff; border-radius: 16rpx; }
.visit-photo-title { margin-bottom: 15rpx; color: #4f5f56; font-size: 26rpx; }
.visit-photo { width: 100%; height: 250rpx; display: block; background: #edf2ef; border-radius: 14rpx; }
.visit-photo-empty { height: 150rpx; display: flex; align-items: center; justify-content: center; color: #527265; background: #f3f7f5; border: 2rpx dashed #cbdad2; border-radius: 14rpx; font-size: 24rpx; }
.visit-photo-actions { margin-top: 13rpx; display: flex; align-items: center; gap: 24rpx; color: #176846; font-size: 22rpx; }
.visit-photo-actions .photo-remove { color: #a95c50; }
.photo-gap-note { margin-top: 12rpx; color: #9b6a2e; font-size: 20rpx; line-height: 1.5; }
.picker-value { color: #26372e; font-size: 27rpx; }
.block-title { margin: 24rpx 4rpx 14rpx; font-size: 27rpx; font-weight: 650; }
.option-grid { display: grid; gap: 12rpx; }
.result-grid { grid-template-columns: repeat(3, 1fr); }
.intent-grid { grid-template-columns: repeat(3, 1fr); }
.option { min-height: 68rpx; display: flex; align-items: center; justify-content: center; border: 1rpx solid #dce5e0; border-radius: 14rpx; background: #fff; color: #536159; font-size: 25rpx; }
.option.selected { border-color: #77b493; background: #eaf7f0; color: #176846; font-weight: 650; }
.switch-row { min-height: 82rpx; display: flex; align-items: center; justify-content: space-between; margin-top: 22rpx; font-size: 27rpx; }
.contact-toggle { padding: 20rpx 4rpx; color: #176846; font-size: 26rpx; font-weight: 600; }
.note-field { padding-top: 20rpx; }
.note-field textarea { width: 100%; height: 116rpx; margin-top: 14rpx; font-size: 26rpx; }
.sheet-actions { display: flex; gap: 16rpx; padding: 14rpx 24rpx 24rpx; background: #fff; border-top: 1rpx solid #e5ebe7; }
.sheet-actions button { flex: 1; height: 76rpx; line-height: 76rpx; border-radius: 38rpx; font-size: 28rpx; }
.cancel { background: #f0f3f1; color: #526159; }
.save { background: #20704e; color: #fff; }
