.upload-section {
  /* width: 100%; */
  padding: 20rpx;
  background-color: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.section-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 24rpx;
}

.excel-section {
  margin-top: 40rpx;
  padding: 20rpx;
  background-color: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

/* 图片网格 */
.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 40rpx;
  padding: 20rpx;
  background-color: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.image-item {
  position: relative;
  width: calc(33.33% - 14rpx);
  aspect-ratio: 1;
  border-radius: 16rpx;
  overflow: hidden;
  background-color: #fff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  transition: transform 0.2s ease;
}

.image-item:active {
  transform: scale(0.98);
}

.image-preview {
  /* width: 100%; */
  height: 100%;
}

.image-delete {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 48rpx;
  height: 48rpx;
  background-color: rgba(0, 0, 0, 0.6);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.delete-icon {
  color: #fff;
  font-size: 40rpx;
  font-weight: bold;
  line-height: 1;
}

.image-status {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: rgba(0, 196, 140, 0.9);
  padding: 8rpx;
  text-align: center;
}

.image-status.error {
  background-color: rgba(255, 0, 0, 0.9);
}

.status-text {
  color: #fff;
  font-size: 26rpx;
}

.add-image {
  border: 2rpx dashed #00c48c;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #f0fdfa 0%, #e6faf5 100%);
  transition: all 0.3s ease;
}

.add-image:active {
  border-color: #00a876;
  background: linear-gradient(135deg, #e6faf5 0%, #d4f5eb 100%);
}

.add-icon {
  font-size: 68rpx;
  color: #00c48c;
  line-height: 1;
  margin-bottom: 12rpx;
  font-weight: 300;
}

.add-text {
  font-size: 30rpx;
  color: #00a876;
  font-weight: 500;
}

/* 按钮样式 */
.btn {
  border: none;
  border-radius: 12rpx;
  font-weight: 600;
  transition: all 0.3s ease;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.btn:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.btn-primary {
  background: linear-gradient(135deg, #00c48c 0%, #00a876 100%);
  color: #fff;
}

.btn-primary:active {
  background: linear-gradient(135deg, #00a876 0%, #008c65 100%);
}

.btn-secondary {
  background: linear-gradient(135deg, #f5f5f5 0%, #e5e5e5 100%);
  color: #333;
}

.btn-secondary:active {
  background: linear-gradient(135deg, #e5e5e5 0%, #d5d5d5 100%);
}

.btn-large {
  /* width: 100%; */
  height: 96rpx;
  line-height: 96rpx;
  font-size: 38rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}



.flex-row-between {
  display: flex;
  flex-flow: row nowrap;
  align-items: center;
  justify-content: space-between;
}

/* Excel 文件信息 */
.excel-file-info {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.excel-icon {
  font-size: 48rpx;
}

.excel-info {
  flex: 1;
}

.excel-name {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
  display: block;
  margin-bottom: 8rpx;
}

.excel-size {
  font-size: 28rpx;
  color: #999;
}

.excel-delete {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #ff4444;
  border-radius: 50%;
}

.excel-delete-icon {
  color: #fff;
  font-size: 36rpx;
  font-weight: bold;
}

.excel-action-bar {
  padding: 30rpx 20rpx 0;
}

/* 图片裁剪弹窗样式 - 完全参考 demo */
.cropper-modal {
  position: fixed;
  top: 200rpx;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.9);
  z-index: 9999;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.3s ease, visibility 0.3s ease;
}

.cropper-modal.show {
  opacity: 1;
  visibility: visible;
}

.cropper-page {
  height: 100%;
  background: #000;
  display: flex;
  flex-direction: column;
}

.cropper-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background-color: rgba(0, 0, 0, 0.8);
  flex-shrink: 0;
}

.cropper-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
}

.cropper-close {
  font-size: 60rpx;
  color: #fff;
  line-height: 1;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.image-wrap {
  position: relative;
  flex: 1;
  overflow: hidden;
}

/* 可缩放、可拖动的裁剪区域（与 ocrImagePreview 一致：超大画布，可见区为中间 100vw*100vh） */
.cropper-movable-area {
  width: 300vw;
  height: 300vh;
  position: absolute;
  left: -100vw;
  top: -100vh;
  overflow: visible;
}

.cropper-movable-view {
  will-change: transform;
  box-sizing: border-box;
}

.cropper-base-image {
  width: 100%;
  height: 100%;
  pointer-events: none;
  display: block;
}

.base-image {
  position: absolute;
}

.crop-box {
  position: absolute;
}

.border {
  width: 100%;
  height: 100%;
  border: 2px solid #00ff99;
  box-sizing: border-box;
}

/* 拉伸手柄 - 完全按照 demo */
.handle {
  position: absolute;
}

.left, .right {
  top: 0;
  width: 20px;
  height: 100%;
  background: transparent;
}
.left { left: -10px; }
.right { right: -10px; }

.top, .bottom {
  left: 0;
  width: 100%;
  height: 20px;
  background: transparent;
}
.top { top: -10px; }
.bottom { bottom: -10px; }

.corner {
  width: 24px;
  height: 24px;
  right: -12px;
  bottom: -12px;
  background: #00ff99;
  border-radius: 50%;
}

.cropper-controls {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 40rpx;
  padding: 30rpx;
  background-color: rgba(0, 0, 0, 0.8);
  flex-shrink: 0;
}

.control-btn {
  width: 80rpx;
  height: 80rpx;
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 50rpx;
  font-weight: bold;
  border: none;
  padding: 0;
}

.control-scale {
  color: #fff;
  font-size: 32rpx;
  min-width: 100rpx;
  text-align: center;
}

.cropper-footer {
  display: flex;
  flex-direction: column;
  padding: 20rpx;
  gap: 16rpx;
  background-color: rgba(0, 0, 0, 0.8);
  flex-shrink: 0;
}

.cropper-footer .flex-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.ocr-mode-selector {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.ocr-mode-selector .mode-item {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.6);
  background-color: rgba(255, 255, 255, 0.15);
  border-radius: 12rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.ocr-mode-selector .mode-item.active {
  color: #00ff99;
  background-color: rgba(0, 255, 153, 0.2);
  border-color: #00ff99;
}

.cropper-recognize-btn {
  width: 100%;
}

.cropper-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
}

.rotate-btn {
  flex: 0 0 auto;
  padding: 0 30rpx;
  background-color: rgba(255, 255, 255, 0.2);
  color: #fff;
}

.cancel-btn {
  background-color: rgba(255, 255, 255, 0.2);
  color: #fff;
}

.crop-box-btn {
  background-color: rgba(0, 255, 153, 0.3);
  color: #00ff99;
}

.confirm-btn {
  background-color: #00ff99;
  color: #000;
}
