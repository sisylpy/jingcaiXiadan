
	<view >

		<view class="emptyView {{total == 0  ? 'is-active' : ''}}" style="height: {{windowHeight - 460}}rpx; text-align:center;margin-top: 180rpx;">
			<view class="empty_view flex-column-center">
				<image class="empty_image" src="../../images/cg.png"></image>
				<text class="big">无现结小票</text>
			</view>
		</view>

		<!-- 月账单 -->
		<view class="flex-column" wx:for="{{billArr}}" wx:for-item="month" wx:for-index="index">
			<view wx:if="{{month.arr.length > 0}}">
				<view class="flex-column with-border-bottom with-padding ">
					<text class="normal">{{month.month}}月</text>
					<view class="flex-row gray small">
						<text class="margin-l-right">订单</text>
						<text class="margin-l-right">{{month.arr.length}}个</text>
						<text class="margin-l-right">金额</text>
						<text>{{month.total}}元</text>
					</view>
				</view>


				<view class="flex-row-between with-padding with-border-bottom" wx:for="{{month.arr}}" wx:for-item="item" style="width: {{windowWidth - 40}}rpx; " hover-class="hover" bindtap="openAccountBill" data-id="{{item.nxRestrauntBillId}}">

					<view class="flex-column">
						<view class="flex-row">
							<text class="margin-right">{{item.nxRbDate}}</text>
							<text>{{item.nxRbDay}}</text>
						</view>
						<!-- <view class="flex-row excreamSmall gray">
							<text>单号:</text>
							<text>{{item.nxRbTradeNo}}</text>
						</view> -->
						<view class="flex-row extreamSmall gray">
							<text>支付时间:</text>
							<text>{{item.nxRbApplyPayTime}}</text>
						</view>
					</view>

					<view class="flex-row with-margin-right">
						<view class="flex-column">
							<view class="flex-row">
								<text class="big ">{{item.nxRbTotal}}</text>
								<text class="small">元</text>
							</view>
						</view>
						<view>
							<image src="../../images/arrow-right-3.png" class="iconsmall with-lr-padding"></image>
						</view>
					</view>
				</view>
			</view>
		</view>
		<!-- ./月账单 4946820201110-->

		<view class="gray extreamSmall with-padding  " style="text-align:center;">显示最近3个月的账单</view>
	</view>

