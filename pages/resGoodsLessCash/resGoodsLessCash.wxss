page {
  background-color: #fff;
}

.top_bar {
  z-index: 500;
}

.search-bar {
  background-color: rgb(241, 241, 241);
  border-radius: 40rpx;
  width: 70%;
  height: 70rpx;
  align-items: center;
}

.navbar {
  display: flex;
  position: relative;
  z-index: 400;
  width: 100%;
  border-bottom: 1rpx solid #f0f0f0;
}

.navbar .navbar-item {
  position: relative;
  display: block;
  flex: 1;
  text-align: center;
  line-height: 80rpx;
  height: 80rpx;
  color: #666;
}

.navbar .navbar-title {
  display: inline-block;
  font-size: 30rpx;
  width: auto;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.navbar .bar-item-on .navbar-title {
  font-weight: 500;
  color: #333;
}

.left {
  width: 140rpx;
}

.itemPic {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
}

.left-item {
  padding: 30rpx 20rpx;
  background-color: rgb(236, 236, 236);
}

.left-active {
  background-color: #fff;
  box-shadow: 6px 6px 6px rgba(116, 116, 116, 0.5);
  margin-bottom: 2rpx;
}

.goods-right-list {
  background-color: #fff;
}

.goods-thumb-wrap {
  width: 160rpx;
  height: 140rpx;
}

.goods-thumb {
  width: 130rpx;
  height: 130rpx;
  border-radius: 12rpx;
}

.goods-price-row {
  margin-top: 10rpx;
  align-items: center;
}

.dep-price-stack {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.dep-price-line {
  line-height: 36rpx;
}

.price-label {
  color: #888;
  margin-right: 8rpx;
}

.price-active {
  color: #111;
}

.price-muted {
  color: #999;
}

.price-strike {
  text-decoration: line-through;
  text-decoration-thickness: 2rpx;
}

.flex-row-baseline {
  display: flex;
  flex-flow: row nowrap;
  align-items: baseline;
}

.weight_five {
  font-weight: 500;
}

.mt-10 {
  margin-top: 10rpx;
}

.margin-left {
  margin-left: 10rpx;
}

.brand {
  border: 1rpx solid #999;
  color: #666;
  padding: 0 6rpx;
  border-radius: 8rpx;
  margin-right: 8rpx;
}

.order_quantity {
  min-width: 80rpx;
  text-align: center;
  font-size: 28rpx;
}

.order-badge {
  min-width: 60rpx;
  padding: 0 12rpx;
  margin-right: 12rpx;
  line-height: 40rpx;
  height: 40rpx;
  text-align: center;
  font-size: 26rpx;
  color: #fff;
  background-color: #07c160;
  border-radius: 20rpx;
}

.order-badge.is-gray {
  background-color: #999;
}

.order-badge.finish {
  background-color: #5d5e5d;
}

.buyBtnSmall {
  background-color: #fcb902;
  border-radius: 50%;
  line-height: 40rpx;
  width: 40rpx;
  height: 40rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 500;
  padding: 4rpx;
}

.reduceBtnSmall {
  border: 1rpx solid gray;
  border-radius: 50%;
  line-height: 40rpx;
  width: 40rpx;
  height: 40rpx;
  text-align: center;
  font-size: 32rpx;
  color: rgb(10, 3, 3);
  padding: 4rpx;
}

.maskPay {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 999999;
  animation: orderMaskFadeIn 180ms ease-out both;
}

.maskPay.is-closing {
  animation: orderMaskFadeOut 180ms ease-in both;
}

.pricing-modal {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  border-top-left-radius: 20rpx;
  border-top-right-radius: 20rpx;
  z-index: 9999999;
  padding-bottom: calc(30rpx + env(safe-area-inset-bottom));
  transform-origin: center bottom;
  animation: orderModalSlideUp 220ms cubic-bezier(0.16, 1, 0.3, 1) both;
}

.pricing-modal.is-closing {
  animation: orderModalSlideDown 180ms cubic-bezier(0.4, 0, 1, 1) both;
}

@keyframes orderMaskFadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes orderMaskFadeOut {
  from {
    opacity: 1;
  }
  to {
    opacity: 0;
  }
}

@keyframes orderModalSlideUp {
  from {
    opacity: 0;
    transform: translateY(80rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes orderModalSlideDown {
  from {
    opacity: 1;
    transform: translateY(0);
  }
  to {
    opacity: 0;
    transform: translateY(80rpx);
  }
}

.pricing-modal-header {
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.pricing-modal-goods {
  align-items: flex-start;
  padding-top: 30rpx;
  padding-bottom: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.pricing-goods-main {
  flex: 1;
  min-width: 0;
  align-items: center;
}

.pricing-goods-info {
  flex: 1;
  min-width: 0;
}

.pricing-top-qty {
  align-items: center;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.pricing-modal-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
}

.pricing-modal-section {
  padding-top: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.pricing-tier-row {
  padding: 14rpx 30rpx;
  color: #666;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.pricing-tier-row.is-active {
  color: #0fbf63;
  background-color: #f0fff6;
  font-weight: 600;
}

.pricing-tag {
  display: inline-block;
  font-size: 20rpx;
  color: #fff;
  background-color: #ff4444;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  margin-left: 10rpx;
  line-height: 28rpx;
  flex-shrink: 0;
}

.pricing-modal-qty {
  align-items: center;
  padding-top: 25rpx;
  padding-bottom: 25rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.pricing-modal-total {
  align-items: center;
  padding-top: 25rpx;
  padding-bottom: 25rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.standardName {
  display: inline-block;
  font-size: 28rpx;
  padding: 10rpx 20rpx;
  line-height: 40rpx;
  background: rgb(234, 235, 235);
  margin-right: 16rpx;
  margin-bottom: 16rpx;
  border-radius: 10rpx;
}

.standardName.is-active {
  background: #07c160;
  color: #fff;
}

.remark-input {
  flex: 1;
  margin-left: 20rpx;
  border-bottom: 1rpx solid #ddd;
  font-size: 28rpx;
  text-align: right;
}

.pricing-modal-actions {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding-top: 20rpx;
}

.pricing-del-btn {
  color: #b41e1e;
  font-size: 28rpx;
  padding: 20rpx;
}

.pricing-modal-btn {
  flex: 1;
  margin-left: 20rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  color: #fff;
  background-color: #07c160;
  border-radius: 12rpx;
  font-size: 32rpx;
}

.pricing-modal-btn.is-disabled {
  background-color: #ccc;
}

.subcat-popup {
  position: fixed;
  left: 5vw;
  right: 5vw;
  background: #fff;
  border-radius: 32rpx;
  z-index: 1001;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.10);
  padding-bottom: 32rpx;
  animation: popupIn 0.2s;
}

@keyframes popupIn {
  from {
    transform: translateY(-30rpx);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

.subcat-bar,
.subcat-bar.expand {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-start;
  padding: 30rpx 40rpx;
  box-sizing: border-box;
  width: 100%;
}

.subcat-bar-scroll {
  width: 100%;
  overflow-x: auto;
  white-space: nowrap;
  padding: 0 0 8rpx 0;
}

.subcat-tag {
  display: inline-block;
  vertical-align: middle;
  padding: 10rpx 20rpx;
  margin: 15rpx 20rpx 15rpx 10rpx;
  border-radius: 24rpx;
  background: #fff;
  color: #333;
  font-size: 28rpx;
  border: 1rpx solid #f0f0f0;
  box-sizing: border-box;
}

.subcat-tag.active {
  border: 1rpx solid #ff2d2d;
  color: #ff2d2d;
  background: #fff;
}

.subcat-toggle {
  display: inline-block;
  vertical-align: middle;
  height: 58rpx;
  width: 58rpx;
  text-align: center;
  line-height: 58rpx;
  background-color: #fff;
  border-radius: 50%;
}

.toggle-icon {
  width: 32rpx;
  height: 32rpx;
  vertical-align: middle;
}

.subcat-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.3);
  z-index: 1000;
}
