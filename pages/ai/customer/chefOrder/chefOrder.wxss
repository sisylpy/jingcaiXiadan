/* 购物车弹出层样式 */
.cart-popup {
  position: fixed;
  bottom: -100%;
  left: 0;
  width: 100%;
  max-height: 80%; /* 最大高度设置为屏幕高度的80% */
  background-color: #fff;
  border-top-left-radius: 20rpx;
  border-top-right-radius: 20rpx;
  z-index: 1000;
  transition: bottom 0.3s ease-in-out;
  display: flex;
  flex-direction: column;
}

/* 弹出时的样式 */
.cart-popup.show {
  bottom: 0;
}

/* 购物车头部样式 */
.cart-header {
  padding: 20rpx;
  border-bottom: 1px solid #e5e5e5;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

/* 关闭按钮样式 */
.close-btn {
  background: none;
  border: none;
  font-size: 30rpx;
}

/* 购物车内容区域样式 */
.cart-content {
  flex: 1;
  overflow-y: scroll;
}

/* 购物车商品项样式 */
.cart-item {
  padding: 20rpx;
  border-bottom: 1px solid #f0f0f0;
}

/* 购物车底部样式 */
.cart-footer {
  padding: 20rpx;
  border-top: 1px solid #e5e5e5;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}


/* 多部门切换弹窗样式 */
.dep-switch-mask {
  position: fixed; left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.35);
  z-index: 2000;
}
.dep-switch-popup {
  position: fixed; left: 50%; top: 50%;
  transform: translate(-50%, -50%);
  width: 70vw; max-width: 600rpx;
  background: #fffbe8;
  border-radius: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.12);
  z-index: 2001;
  padding: 40rpx 0 20rpx 0;
  display: flex; flex-direction: column; align-items: center;
  animation: popup-fade-in 0.25s;
}
@keyframes popup-fade-in {
  from { opacity: 0; transform: scale(0.95) translate(-50%, -50%);}
  to { opacity: 1; transform: scale(1) translate(-50%, -50%);}
}
.dep-switch-title {
  font-size: 36rpx; font-weight: bold; color: #333;
  display: flex; align-items: center; margin-bottom: 24rpx;
}
.dep-switch-icon {
  width: 40rpx; height: 40rpx; margin-right: 12rpx;
}
.dep-switch-list {
  max-height: 400rpx; width: 100%;
  overflow-y: auto;
}
.dep-switch-item {
  display: flex; align-items: center; justify-content: space-between;
  padding: 28rpx 48rpx;
  font-size: 32rpx;
  border-radius: 20rpx;
  margin: 0 24rpx 18rpx 24rpx;
  background: #fff;
  color: #333;
  transition: background 0.2s;
}
.dep-switch-item.selected {
  background: #00c48f;
  color: #fff;
  font-weight: bold;
  box-shadow: 0 4rpx 16rpx rgba(0,196,143,0.08);
}
.dep-switch-item.selected .dep-switch-check {
  display: inline-block;
}
.dep-switch-check {
  width: 32rpx; height: 32rpx; margin-left: 10rpx;
}
.dep-switch-tip {
  margin-top: 18rpx;
  color: #aaa;
  font-size: 24rpx;
  text-align: center;
}

/* 动画效果 */
@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes scaleIn {
  from {
    transform: scale(0.95);
  }
  to {
    transform: scale(1);
  }
}

/* 响应式设计 */
@media (max-width: 750rpx) {
  .radio-option,
  .radio-option1 {
    padding: 20rpx 24rpx;
    margin: 8rpx 0;
  }
  
  .department-picker1 {
    padding: 20rpx 24rpx;
  }
  
  .font-md {
    font-size: 28rpx;
  }
}

/* 交互反馈 */
.radio-option:active,
.radio-option1:active {
  transform: scale(0.98);
  transition: transform 0.1s ease;
}

.department-picker1:active {
  transform: scale(0.98);
  transition: transform 0.1s ease;
}

