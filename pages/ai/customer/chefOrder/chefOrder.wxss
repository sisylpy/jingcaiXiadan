/* 单选按钮样式 */
.radio-option {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  margin: 8rpx 0;
  border: 2rpx solid #e5e5e5;
  border-radius: 12rpx;
  background: #fafbfc;
  transition: all 0.3s ease;
  cursor: pointer;
  width: fit-content;
  min-width: 200rpx;
}

.radio-option.selected {
  border-color: #07c160;
  background: #f0f9f4;
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.15);
}

.radio-option1 {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  margin: 8rpx 0;
  border: 2rpx solid #e5e5e5;
  border-radius: 12rpx;
  background: #fafbfc;
  transition: all 0.3s ease;
  cursor: pointer;
  width: 100%;
  max-width: 300rpx;
}

.radio-option1.selected {
  border-color: #07c160;
  background: #f0f9f4;
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.15);
}

.radio-circle {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #ddd;
  border-radius: 50%;
  margin-left: 16rpx;
  position: relative;
  transition: all 0.3s ease;
  flex-shrink: 0;
}

.radio-circle.checked {
  border-color: #07c160;
  background-color: #07c160;
  transform: scale(1.1);
}

.radio-circle.checked::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 18rpx;
  height: 18rpx;
  background-color: white;
  border-radius: 50%;
}

