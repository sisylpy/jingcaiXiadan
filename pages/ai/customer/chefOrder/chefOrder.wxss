.page-root {
  height: 100vh;
  min-height: 100vh;
  background-color: #f5f5f5;
  display: flex;
  flex-direction: column;
}

page {
  width: 100vw;
  height: 100vh;
  background: #f8f8f8;
  position: relative;
}
.content {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.scroll-content {
  /* flex: 1; */
  min-height: 0;
}

.iconB {
  width: 20px;
  height: 20px;
  /* margin-bottom: 2px; */
}

.icon-button {

  display: flex;
  flex-direction: column;
  align-items: center;
  border: none;
  padding: 10px;
  cursor: pointer;
  border-radius: 5px;
}

.button-text{
  font-size: 26rpx;
}

.page-bg {
  min-height: 100vh;
  background-image: url('https://grainservice.club:8443/nongxinle/uploadImage/ChatMainBack.png');
  background-size: cover;
  background-repeat: no-repeat;
  background-position: center;
}





/* 服务停用提示仍由页面本身展示。 */
.popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.35);
  z-index: 1000;
}

.popup-container {
  position: fixed;
  left: 50%;
  top: 40%;
  transform: translate(-50%, -50%);
  background: #fff;
  border-radius: 32rpx;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.18);
  width: 600rpx;
  max-width: 90vw;
  z-index: 1001;
  padding: 0 0 40rpx 0;
}
