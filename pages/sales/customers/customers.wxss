.page { min-height: 100vh; color: #17251f; background: #f4f7f5; }
.header { min-height: 130rpx; padding-right: 28rpx; padding-bottom: 34rpx; padding-left: 28rpx; display: flex; align-items: flex-end; justify-content: space-between; color: #fff; background: linear-gradient(145deg, #184f3a, #277452); }
.header-left { display: flex; align-items: flex-end; }
.back { width: 56rpx; height: 56rpx; margin-right: 4rpx; flex: none; color: #fff; font-size: 52rpx; font-weight: 300; line-height: 48rpx; text-align: center; }
.title { font-size: 38rpx; font-weight: 700; }
.subtitle { margin-top: 8rpx; font-size: 23rpx; opacity: .78; }
.add { padding: 13rpx 20rpx; border: 1rpx solid rgba(255,255,255,.5); border-radius: 26rpx; font-size: 24rpx; }
.search-wrap { height: 82rpx; margin: -18rpx 24rpx 0; padding: 0 22rpx; display: flex; align-items: center; border-radius: 18rpx; background: #fff; box-shadow: 0 9rpx 25rpx rgba(24,79,58,.1); }
.search-wrap image { width: 31rpx; height: 31rpx; margin-right: 13rpx; opacity: .55; }
.search-wrap input { flex: 1; height: 82rpx; font-size: 26rpx; }
.clear { width: 46rpx; color: #8b9690; text-align: center; font-size: 34rpx; }
.summary { padding: 24rpx 28rpx 13rpx; color: #77857d; font-size: 23rpx; }
.list { padding: 0 24rpx; }
.customer-card { min-height: 132rpx; margin-bottom: 15rpx; padding: 22rpx; display: flex; align-items: center; box-sizing: border-box; border: 1rpx solid #e4ebe7; border-radius: 19rpx; background: #fff; box-shadow: 0 4rpx 16rpx rgba(25,74,51,.035); }
.avatar { width: 70rpx; height: 70rpx; margin-right: 18rpx; flex: none; border-radius: 22rpx; color: #20704e; background: #e8f5ed; font-size: 27rpx; font-weight: 650; line-height: 70rpx; text-align: center; }
.customer-main { min-width: 0; flex: 1; }
.customer-name { overflow: hidden; font-size: 29rpx; font-weight: 680; text-overflow: ellipsis; white-space: nowrap; }
.customer-address { margin-top: 7rpx; overflow: hidden; color: #78857e; font-size: 22rpx; text-overflow: ellipsis; white-space: nowrap; }
.customer-meta { margin-top: 8rpx; color: #3d765b; font-size: 21rpx; }
.arrow { margin-left: 12rpx; color: #789083; font-size: 39rpx; }
.empty, .loading { padding: 100rpx 30rpx; color: #89948e; text-align: center; font-size: 25rpx; }
