page {
  background: #f6f7f8;
  color: #18201c;
}

.page {
  min-height: 100vh;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.toolbar {
  padding: 16rpx 24rpx 10rpx;
  background: #fff;
}

.search-box {
  height: 72rpx;
  padding: 0 22rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #f3f4f5;
  border-radius: 12rpx;
}

.search-icon {
  width: 30rpx;
  height: 30rpx;
  opacity: 0.58;
}

.search-input {
  flex: 1;
  height: 72rpx;
  font-size: 28rpx;
}

.clear {
  padding: 10rpx;
  color: #87918c;
  font-size: 34rpx;
  line-height: 1;
}

.content {
  padding: 14rpx 24rpx 0 24rpx;
  box-sizing: border-box;
}

.summary {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  padding: 20rpx 0;
  background: #fff;
  border: 1rpx solid #edf0ee;
  border-radius: 12rpx;
}

.summary-item {
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  border-right: 1rpx solid #edf0ee;
}

.summary-item:last-child {
  border-right: 0;
}

.summary-label {
  margin-bottom: 8rpx;
  color: #7f8984;
  font-size: 22rpx;
  white-space: nowrap;
}

.summary-value {
  color: #202923;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1;
}

.summary-value text {
  margin-left: 4rpx;
  color: #8c9691;
  font-size: 20rpx;
  font-weight: 400;
}

.summary-value.emphasis {
  color: #d24c43;
}

.sort-line {
  height: 68rpx;
  padding: 0 4rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #35403a;
  font-size: 26rpx;
  font-weight: 600;
}

.sort-desc {
  color: #8a948f;
  font-size: 22rpx;
  font-weight: 400;
}

.goods-group {
  margin-bottom: 18rpx;
  overflow: hidden;
  background: #fff;
  border: 1rpx solid #e9edeb;
  border-radius: 10rpx;
}

.group-title {
  height: 88rpx;
  padding: 0 24rpx 0 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fafbfa;
}

.group-name-wrap {
  height: 100%;
  display: flex;
  align-items: center;
}

.group-line {
  width: 6rpx;
  height: 32rpx;
  margin-right: 16rpx;
  background: #169b59;
  border-radius: 0 4rpx 4rpx 0;
}

.group-name {
  color: #1e2822;
  font-size: 28rpx;
  font-weight: 700;
}

.group-range {
  margin-left: 6rpx;
  color: #7f8984;
  font-size: 22rpx;
}

.group-count {
  min-width: 34rpx;
  padding: 3rpx 9rpx;
  color: #168a52;
  font-size: 21rpx;
  text-align: center;
  background: #eaf6ef;
  border-radius: 8rpx;
}

.group-title-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.group-arrow {
  width: 28rpx;
  height: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9aa39e;
  font-size: 24rpx;
  line-height: 1;
  transition: transform 0.2s ease;
}

.group-arrow.collapsed {
  transform: rotate(-90deg);
}

.group-blue .group-line {
  background: #4f81dc;
}

.group-blue .group-count {
  color: #3972d1;
  background: #edf3fd;
}

.group-orange .group-line {
  background: #e88923;
}

.group-orange .group-count {
  color: #d57413;
  background: #fff3e7;
}

.group-gray .group-line {
  background: #7e8993;
}

.group-gray .group-count,
.group-light .group-count {
  color: #6e7973;
  background: #f0f2f1;
}

.group-light .group-line {
  background: #b4bbb7;
}

.goods-row {
  min-height: 112rpx;
  padding: 14rpx 16rpx;
  display: grid;
  grid-template-columns: 64rpx minmax(0, 1fr) 112rpx 112rpx 18rpx;
  gap: 14rpx;
  align-items: center;
  border-top: 1rpx solid #edf0ee;
}

.goods-avatar {
  width: 62rpx;
  height: 62rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  color: #63716a;
  font-size: 26rpx;
  font-weight: 700;
  background: #f1f4f2;
  border: 1rpx solid #e5eae7;
  border-radius: 10rpx;
}

.goods-avatar image {
  width: 100%;
  height: 100%;
}

.goods-main {
  min-width: 0;
}

.goods-name {
  display: block;
  overflow: hidden;
  color: #172019;
  font-size: 32rpx;
  font-weight: 650;
  line-height: 40rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-spec {
  display: block;
  margin-top: 3rpx;
  overflow: hidden;
  color: #747f79;
  font-size: 22rpx;
  line-height: 28rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-tags {
  margin-top: 5rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.requirement-tag {
  padding: 2rpx 8rpx;
  color: #c93e38;
  font-size: 19rpx;
  line-height: 25rpx;
  background: #fff0ef;
  border-radius: 5rpx;
}

.image-tag {
  display: flex;
  align-items: center;
  gap: 4rpx;
  color: #6f7a74;
  font-size: 20rpx;
}

.image-symbol {
  font-size: 22rpx;
}

.frequency,
.last-order {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.frequency-value {
  color: #168f55;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 34rpx;
}

.frequency-unit,
.last-label {
  margin-top: 4rpx;
  color: #89938e;
  font-size: 19rpx;
  line-height: 24rpx;
}

.last-value {
  margin-top: 3rpx;
  color: #2e3933;
  font-size: 23rpx;
  font-weight: 600;
  line-height: 30rpx;
}

.row-arrow {
  color: #9ba49f;
  font-size: 36rpx;
  line-height: 1;
}

.empty-state {
  padding: 140rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-title {
  color: #3c4741;
  font-size: 28rpx;
  font-weight: 600;
}

.empty-desc {
  margin-top: 12rpx;
  color: #929b96;
  font-size: 23rpx;
}
