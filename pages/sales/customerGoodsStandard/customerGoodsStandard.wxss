.page { min-height:100vh; background:#f5f7f6; color:#19261f; padding-bottom:40rpx; }.nav { height:88rpx; background:#fff; display:flex; align-items:center; justify-content:space-between; padding:0 24rpx; }.back { width:100rpx; font-size:54rpx; color:#1d6c4a; }.nav-title { font-size:32rpx; font-weight:650; }.history-link { width:100rpx; text-align:right; color:#1e704d; font-size:26rpx; }
.goods-head { margin:22rpx 24rpx; border-radius:20rpx; padding:28rpx; color:#fff; background:linear-gradient(145deg,#1a6245,#2b845d); }.customer-name { font-size:24rpx; opacity:.78; }.goods-name { margin-top:8rpx; font-size:38rpx; font-weight:700; }.section { margin:0 24rpx 20rpx; padding:26rpx; background:#fff; border-radius:18rpx; }.section-title { font-size:29rpx; font-weight:650; margin-bottom:18rpx; }.empty { color:#8a948e; font-size:24rpx; padding:20rpx 0; line-height:1.6; }
.requirement { display:flex; align-items:center; gap:20rpx; padding:22rpx 0; border-top:1rpx solid #edf0ee; }.requirement-main { flex:1; }.requirement-label { color:#23714f; font-size:23rpx; }.requirement-text { font-size:28rpx; line-height:1.55; margin-top:8rpx; }.deactivate,.image-remove { color:#b45a53; font-size:23rpx; }.select-row { display:flex; gap:14rpx; }.select { padding:18rpx 20rpx; border-radius:12rpx; background:#eef6f1; color:#276b4b; font-size:24rpx; }.textarea { box-sizing:border-box; width:100%; min-height:180rpx; margin-top:18rpx; padding:20rpx; background:#f5f7f6; border-radius:14rpx; font-size:27rpx; }.reason { box-sizing:border-box; width:100%; height:74rpx; margin-top:14rpx; padding:0 20rpx; background:#f5f7f6; border-radius:12rpx; font-size:25rpx; }.save,.image-button { margin-top:18rpx; height:80rpx; line-height:80rpx; border-radius:40rpx; background:#20704e; color:#fff; font-size:27rpx; }.image-button { background:#eef6f1; color:#1d704c; border:1rpx solid #a9cdb9; }
.image-grid { display:grid; grid-template-columns:1fr 1fr; gap:14rpx; }.image-card { position:relative; background:#f5f7f6; border-radius:14rpx; overflow:hidden; padding-bottom:16rpx; }.image-card image { width:100%; height:210rpx; }.image-caption { font-size:22rpx; padding:12rpx 14rpx 4rpx; }.image-remove { padding:4rpx 14rpx; }.image-options { margin-top:20rpx; }.history-row { padding:18rpx 0; border-top:1rpx solid #edf0ee; font-size:25rpx; }.history-time { color:#8b9590; font-size:21rpx; margin-top:7rpx; }
