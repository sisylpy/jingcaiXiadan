.page { min-height: 100vh; background: #f4f7f5; color: #17251f; }
.top { background: linear-gradient(145deg, #184f3a, #277452); color: #fff; padding: 0 32rpx 42rpx; }
.top-row { min-height: 92rpx; display: flex; align-items: center; justify-content: space-between; }
.title { font-size: 38rpx; font-weight: 700; }
.subtitle { margin-top: 8rpx; font-size: 24rpx; opacity: .78; }
.top-action { padding: 12rpx 18rpx; border: 1rpx solid rgba(255,255,255,.45); border-radius: 28rpx; font-size: 25rpx; }
.search-wrap { margin: -22rpx 24rpx 18rpx; }
.search { height: 84rpx; padding: 0 28rpx; border-radius: 18rpx; background: #fff; box-shadow: 0 10rpx 28rpx rgba(24,79,58,.1); font-size: 27rpx; }
.search-results { margin: 0 24rpx 18rpx; padding: 0 24rpx; background: #fff; border-radius: 18rpx; box-shadow: 0 8rpx 24rpx rgba(24,79,58,.07); }
.search-empty { padding: 28rpx 0; color: #849088; text-align: center; font-size: 24rpx; line-height: 1.5; }
.customer-row { min-height: 94rpx; display: flex; align-items: center; border-bottom: 1rpx solid #edf1ef; }
.customer-row:last-child { border-bottom: 0; }
.customer-main { min-width: 0; flex: 1; }
.customer-name { font-size: 29rpx; font-weight: 650; }
.customer-address { margin-top: 7rpx; color: #7b8780; font-size: 23rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.arrow { color: #20704e; font-size: 40rpx; }
.content { padding: 0 24rpx; }
.today-card { padding: 28rpx; border-radius: 20rpx; background: #fff; box-shadow: 0 6rpx 20rpx rgba(25,74,51,.05); }
.honest-empty { margin-top: 18rpx; padding: 22rpx; border-radius: 15rpx; color: #708078; background: #f5f8f6; font-size: 24rpx; line-height: 1.65; }
.core-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14rpx; }
.core-card { position: relative; min-height: 230rpx; padding: 22rpx 18rpx; box-sizing: border-box; border: 1rpx solid #e1e9e4; border-radius: 20rpx; background: #fff; }
.core-card.customer { background: linear-gradient(155deg, #fff, #edf8f2); }
.core-card.quotation { background: linear-gradient(155deg, #fff, #eef3ff); }
.core-card.follow { background: linear-gradient(155deg, #fff, #f6efff); }
.core-icon { width: 54rpx; height: 54rpx; border-radius: 16rpx; color: #fff; background: #23805a; font-size: 23rpx; font-weight: 700; line-height: 54rpx; text-align: center; }
.quotation .core-icon { background: #4f6fd1; }
.follow .core-icon { background: #7a49c5; }
.core-title { margin-top: 18rpx; font-size: 29rpx; font-weight: 700; }
.core-note { margin-top: 10rpx; color: #75827b; font-size: 21rpx; line-height: 1.5; }
.core-arrow { position: absolute; right: 16rpx; bottom: 12rpx; color: #648073; font-size: 36rpx; }
.visit-card { padding: 28rpx; border-radius: 20rpx; background: #fff; box-shadow: 0 6rpx 20rpx rgba(25,74,51,.05); }
.visit-head { display: flex; align-items: center; justify-content: space-between; }
.card-title, .section-title { font-size: 30rpx; font-weight: 700; }
.card-note { margin-top: 8rpx; color: #78857e; font-size: 23rpx; }
.visit-button { min-width: 136rpx; height: 68rpx; padding: 0 20rpx; border-radius: 34rpx; background: #20704e; color: #fff; font-size: 27rpx; line-height: 68rpx; text-align: center; }
.type-list { display: flex; flex-wrap: wrap; gap: 14rpx; margin-top: 24rpx; }
.type-chip { padding: 13rpx 23rpx; border: 1rpx solid #d9e5de; border-radius: 28rpx; background: #f7faf8; color: #3f5549; font-size: 25rpx; }
.sales-tools { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; margin-top: 20rpx; }
.sales-tool { min-height: 116rpx; padding: 20rpx; display: flex; align-items: center; border-radius: 18rpx; background: #fff; box-sizing: border-box; }
.sales-tool > view:nth-child(2) { flex: 1; min-width: 0; margin-left: 14rpx; }
.sales-tool > text { color: #7a8981; font-size: 35rpx; }
.tool-icon { width: 52rpx; height: 52rpx; border-radius: 14rpx; color: #246c4d; background: #e4f2e9; font-size: 24rpx; line-height: 52rpx; text-align: center; }
.tool-icon.quote { color: #b45d28; background: #fff0df; }
.tool-title { font-size: 25rpx; font-weight: 650; }
.tool-note { margin-top: 6rpx; color: #86928b; font-size: 20rpx; line-height: 1.35; }
.section-head { margin: 30rpx 4rpx 14rpx; display: flex; align-items: center; justify-content: space-between; }
.section-more { color: #20704e; font-size: 24rpx; }
.follow-card { padding: 0 24rpx; border-radius: 18rpx; background: #fff; }
.empty-follow { padding: 34rpx 0; color: #89948e; text-align: center; font-size: 25rpx; }
.follow-row { min-height: 98rpx; display: flex; align-items: center; border-bottom: 1rpx solid #edf1ef; }
.follow-row:last-child { border-bottom: 0; }
.follow-main { min-width: 0; flex: 1; }
.follow-name { font-size: 29rpx; font-weight: 650; }
.follow-meta { margin-top: 7rpx; color: #7b8780; font-size: 23rpx; }
.intent { min-width: 52rpx; height: 52rpx; border-radius: 50%; background: #eaf7f0; color: #20704e; font-size: 23rpx; line-height: 52rpx; text-align: center; }
.intent.hot { background: #fff0e3; color: #c66b20; }
.quick-actions { display: grid; grid-template-columns: 1fr 1.35fr; gap: 14rpx; }
.quick-action { min-height: 96rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; border: 1rpx solid #e0e8e3; border-radius: 17rpx; background: #fff; color: #405249; font-size: 24rpx; }
.quick-icon { margin-bottom: 5rpx; color: #20704e; font-size: 30rpx; font-weight: 700; }
.loading { padding: 50rpx 0; color: #8b9590; text-align: center; font-size: 26rpx; }
