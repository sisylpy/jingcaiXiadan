<view class="page">
  <view class="top" style="padding-top: {{statusBarHeight}}px">
    <view class="top-row">
      <view>
        <view class="title">销售助手</view>
        <view class="subtitle" wx:if="{{profile}}">{{profile.salesInfo.nxDiuWxNickName || '业务员'}} · {{profile.disInfo.nxDistributerShowName || profile.disInfo.nxDistributerName}}</view>
      </view>
      <view class="top-action" bindtap="openProfile">我的</view>
    </view>
  </view>

  <view class="search-wrap">
    <input class="search" placeholder="搜索客户、门店名称或地址" value="{{keyword}}" bindinput="onKeywordInput" />
  </view>

  <view class="search-results" wx:if="{{keyword}}">
    <view class="search-empty" wx:if="{{!loading && customers.length === 0}}">没有找到已分配客户，可先记录一次陌生门店拜访</view>
    <view class="customer-row" wx:for="{{customers}}" wx:key="nxDepartmentId" data-id="{{item.nxDepartmentId}}" bindtap="openCustomer">
      <view class="customer-main">
        <view class="customer-name">{{item.nxDepartmentName}}</view>
        <view class="customer-address">{{item.nxDepartmentAddress || '未填写地址'}}</view>
      </view>
      <view class="arrow">›</view>
    </view>
  </view>

  <view class="content">
    <view class="today-card">
      <view class="card-title">今日工作</view>
      <view class="honest-empty">统一今日任务尚未接入，本页不展示推断数量。请从客户、报价或跟进进入当前工作。</view>
    </view>

    <view class="section-head"><view class="section-title">核心工作</view></view>
    <view class="core-grid">
      <view class="core-card customer" bindtap="openCustomers">
        <view class="core-icon">客</view>
        <view class="core-title">客户</view>
        <view class="core-note">正式客户、商品标准、代客下单</view>
        <view class="core-arrow">›</view>
      </view>
      <view class="core-card quotation" bindtap="openQuotationCenter">
        <view class="core-icon">价</view>
        <view class="core-title">报价</view>
        <view class="core-note">OCR、业态推荐、手工报价</view>
        <view class="core-arrow">›</view>
      </view>
      <view class="core-card follow" bindtap="openFollowUp">
        <view class="core-icon">跟</view>
        <view class="core-title">跟进</view>
        <view class="core-note">线索跟进与最近拜访</view>
        <view class="core-arrow">›</view>
      </view>
    </view>

    <view class="section-head"><view class="section-title">快速操作</view></view>
    <view class="quick-actions">
      <view class="quick-action" bindtap="addCustomer"><text class="quick-icon">＋</text><text>新增客户</text></view>
      <view class="quick-action" bindtap="startVisit"><text class="quick-icon">记</text><text>记录陌生门店 / 初次拜访</text></view>
    </view>
  </view>

  <view class="loading" wx:if="{{loading}}">正在加载…</view>

  <sales-visit-sheet visible="{{showVisitSheet}}" business-types="{{businessTypes}}"
    target="{{visitTarget}}" bind:close="closeVisitSheet" bind:saved="onVisitSaved" />
</view>
