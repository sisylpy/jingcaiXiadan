page { background: #f4f7f5; }

.page {
  width: 100%;
  min-height: 100vh;
  overflow-x: hidden;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  color: #17251f;
  background: #f4f7f5;
}

.header {
  width: 100%;
  min-height: 178rpx;
  padding-right: 26rpx;
  padding-bottom: 56rpx;
  padding-left: 26rpx;
  box-sizing: border-box;
  color: #fff;
  background: linear-gradient(145deg, #155d40, #168051);
}

.header-row { display: flex; align-items: flex-end; justify-content: space-between; }
.header-left { min-width: 0; display: flex; align-items: center; }

.back {
  width: 52rpx;
  height: 58rpx;
  margin-right: 6rpx;
  flex: none;
  color: #fff;
  font-size: 52rpx;
  font-weight: 300;
  line-height: 50rpx;
  text-align: center;
}

.header-copy { min-width: 0; }
.title { font-size: 37rpx; font-weight: 700; }
.subtitle { margin-top: 7rpx; overflow: hidden; color: rgba(255,255,255,.82); font-size: 21rpx; text-overflow: ellipsis; white-space: nowrap; }

.add {
  margin-left: 14rpx;
  padding: 12rpx 19rpx;
  flex: none;
  border: 1rpx solid rgba(255,255,255,.55);
  border-radius: 26rpx;
  font-size: 23rpx;
}

.content {
  width: 100%;
  margin-top: -35rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.work-summary {
  width: 100%;
  min-height: 82rpx;
  padding: 18rpx 24rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  border: 1rpx solid #e0e8e3;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(24, 79, 54, .075);
}

.summary-dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 14rpx;
  flex: none;
  border-radius: 50%;
  background: #48a56f;
}

.summary-text { min-width: 0; color: #56665d; font-size: 23rpx; line-height: 1.5; }
.summary-text text { color: #18734a; font-size: 27rpx; font-weight: 750; }
.summary-text .overdue-count { color: #d4513f; }

.filter-scroll { width: 100%; margin-top: 20rpx; white-space: nowrap; }
.filter-row { display: inline-flex; padding-right: 8rpx; gap: 12rpx; }

.filter-item {
  min-width: 126rpx;
  padding: 13rpx 20rpx;
  box-sizing: border-box;
  border: 1rpx solid #dfe7e2;
  border-radius: 28rpx;
  color: #65736b;
  background: #fff;
  font-size: 23rpx;
  text-align: center;
}

.filter-item.active { border-color: #258058; color: #176f49; background: #e9f5ee; font-weight: 700; }

.list-head {
  padding: 24rpx 3rpx 14rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 28rpx;
  font-weight: 700;
}

.sort-label { color: #859189; font-size: 20rpx; font-weight: 400; }
.lead-list { width: 100%; }

.lead-card {
  width: 100%;
  margin-bottom: 17rpx;
  padding: 22rpx;
  box-sizing: border-box;
  border: 1rpx solid #e0e8e3;
  border-radius: 19rpx;
  background: #fff;
  box-shadow: 0 5rpx 18rpx rgba(25, 74, 51, .04);
}

.lead-card:active { background: #fbfcfb; }
.customer-main { width: 100%; display: flex; align-items: flex-start; }

.customer-photo {
  width: 128rpx;
  height: 128rpx;
  margin-right: 18rpx;
  flex: none;
  overflow: hidden;
  border-radius: 14rpx;
  background: #e8f1eb;
}

.customer-photo image { width: 100%; height: 100%; display: block; }

.photo-placeholder {
  width: 100%;
  height: 100%;
  color: #39825c;
  background: linear-gradient(145deg, #e5f2e9, #d8eadf);
  font-size: 45rpx;
  font-weight: 700;
  line-height: 128rpx;
  text-align: center;
}

.customer-info { min-width: 0; flex: 1; }
.name-row { display: flex; align-items: center; gap: 10rpx; }
.customer-name { min-width: 0; overflow: hidden; flex: 1; font-size: 30rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }

.stage {
  padding: 6rpx 11rpx;
  flex: none;
  border-radius: 16rpx;
  color: #5f6d65;
  background: #edf1ef;
  font-size: 19rpx;
}

.stage.NEW { color: #537066; background: #edf4f0; }
.stage.INTERESTED { color: #9d621a; background: #fff0dc; }
.stage.QUOTED { color: #396aaa; background: #eaf1fb; }
.stage.CONVERTED { color: #23774f; background: #e4f4ea; }
.stage.CLOSED { color: #7f8984; background: #eef0ef; }

.info-line {
  min-width: 0;
  margin-top: 8rpx;
  display: flex;
  align-items: flex-start;
  color: #68776f;
  font-size: 21rpx;
  line-height: 1.4;
}

.info-icon {
  width: 30rpx;
  height: 30rpx;
  margin-right: 7rpx;
  flex: none;
  border-radius: 9rpx;
  color: #39825c;
  background: #edf6f0;
  font-size: 17rpx;
  line-height: 30rpx;
  text-align: center;
}

.address-line text:last-child {
  overflow: hidden;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.detail-arrow { width: 24rpx; margin-left: 8rpx; flex: none; color: #9aa59f; font-size: 37rpx; line-height: 38rpx; }

.customer-metrics {
  margin-top: 18rpx;
  padding: 15rpx 16rpx;
  display: grid;
  grid-template-columns: 1.45fr .75fr .75fr;
  gap: 8rpx;
  box-sizing: border-box;
  border-radius: 13rpx;
  background: #f5f8f6;
}

.metric { min-width: 0; display: flex; flex-direction: column; color: #7b8881; font-size: 19rpx; }
.metric text:last-child { margin-top: 5rpx; overflow: hidden; color: #35473d; font-size: 22rpx; font-weight: 650; text-overflow: ellipsis; white-space: nowrap; }
.latest-note { margin-top: 14rpx; overflow: hidden; color: #52625a; font-size: 22rpx; line-height: 1.5; text-overflow: ellipsis; white-space: nowrap; }

.next-row {
  margin-top: 17rpx;
  padding-top: 16rpx;
  display: flex;
  align-items: center;
  border-top: 1rpx solid #ebf0ed;
}

.next-main { min-width: 0; flex: 1; }
.next-title-row { display: flex; align-items: center; gap: 10rpx; }
.next-title { min-width: 0; overflow: hidden; color: #263a2f; font-size: 23rpx; font-weight: 650; text-overflow: ellipsis; white-space: nowrap; }

.action-status {
  padding: 5rpx 9rpx;
  flex: none;
  border-radius: 13rpx;
  color: #9d6c17;
  background: #fff1d5;
  font-size: 18rpx;
}

.action-status.TODAY { color: #9d621a; background: #fff0dc; }
.action-status.OVERDUE { color: #c84738; background: #fdebea; }
.action-status.IN_PROGRESS { color: #19734a; background: #e5f4eb; }
.action-status.SCHEDULED { color: #416e9d; background: #edf3fa; }
.next-time { margin-top: 7rpx; overflow: hidden; color: #7d8982; font-size: 20rpx; text-overflow: ellipsis; white-space: nowrap; }
.next-time.overdue { color: #d4513f; }

.lead-action {
  width: 132rpx;
  height: 62rpx;
  margin-left: 16rpx;
  flex: none;
  border-radius: 31rpx;
  color: #fff;
  background: #238059;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 62rpx;
  text-align: center;
}

.lead-action.outline { border: 1rpx solid #58a27a; box-sizing: border-box; color: #23774f; background: #fff; }
.empty, .loading { padding: 100rpx 24rpx; color: #89948e; font-size: 25rpx; text-align: center; }
.empty-note { margin-top: 13rpx; font-size: 21rpx; }
