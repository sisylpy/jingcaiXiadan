page { background: #f4f7f5; }

.page {
  width: 100%;
  min-height: 100vh;
  overflow-x: hidden;
  padding-bottom: 42rpx;
  box-sizing: border-box;
  background: #f4f7f5;
  color: #17251f;
}

.page.has-bottom-bar { padding-bottom: calc(150rpx + env(safe-area-inset-bottom)); }

.header {
  padding: 24rpx 30rpx 58rpx;
  box-sizing: border-box;
  color: #fff;
  background: linear-gradient(145deg, #0f7046 0%, #148451 65%, #5aae78 100%);
}

.header-row { display: flex; align-items: center; }

.back {
  width: 58rpx;
  height: 58rpx;
  flex: none;
  color: #fff;
  font-size: 52rpx;
  line-height: 50rpx;
  text-align: center;
}

.header-main { min-width: 0; flex: 1; }
.title { font-size: 38rpx; font-weight: 700; letter-spacing: 1rpx; }
.subtitle { margin-top: 7rpx; color: rgba(255,255,255,.82); font-size: 23rpx; }

.content {
  width: 100%;
  margin-top: -34rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.task-card,
.section-card {
  width: 100%;
  margin-bottom: 18rpx;
  padding: 25rpx;
  box-sizing: border-box;
  border: 1rpx solid #e0e9e3;
  border-radius: 18rpx;
  background: #fff;
  box-shadow: 0 7rpx 24rpx rgba(30, 78, 54, .055);
}

.task-card { display: flex; align-items: flex-start; }

.task-icon {
  width: 68rpx;
  height: 68rpx;
  margin-right: 20rpx;
  flex: none;
  border-radius: 50%;
  color: #fff;
  background: linear-gradient(145deg, #55ad68, #2d8d52);
  font-size: 31rpx;
  line-height: 68rpx;
  text-align: center;
}

.task-main { min-width: 0; flex: 1; }
.task-head { display: flex; align-items: flex-start; justify-content: space-between; }
.task-title { min-width: 0; flex: 1; font-size: 31rpx; font-weight: 700; }

.status {
  margin-left: 14rpx;
  padding: 7rpx 14rpx;
  flex: none;
  border-radius: 18rpx;
  color: #a66e11;
  background: #fff1d5;
  font-size: 21rpx;
}

.status.TODO { color: #a66e11; background: #fff1d5; }
.status.COMPLETED { color: #69766f; background: #eef2ef; }

.task-meta {
  margin-top: 13rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #7b8881;
  font-size: 22rpx;
}

.task-meta text:last-child { margin-left: 20rpx; color: #405048; text-align: right; }

.section-title { margin-bottom: 18rpx; font-size: 29rpx; font-weight: 700; }
.section-title.no-margin { margin-bottom: 0; }
.icon-title { display: flex; align-items: center; }

.section-icon {
  width: 38rpx;
  height: 38rpx;
  margin-right: 12rpx;
  border-radius: 12rpx;
  color: #147447;
  background: #e5f5eb;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 38rpx;
  text-align: center;
}

.section-icon.pale { color: #59816c; background: #eff5f1; }
.section-icon.done { color: #fff; background: #3c9960; }
.context-customer { margin: 2rpx 0 10rpx 50rpx; font-size: 28rpx; font-weight: 700; }

.context-row {
  min-height: 60rpx;
  padding-left: 50rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  color: #617168;
  font-size: 23rpx;
}

.context-label { color: #77847d; }
.context-value { max-width: 430rpx; margin-left: 18rpx; color: #36473e; text-align: right; }
.context-value.strong { color: #26784e; font-weight: 700; }

.feedback-box {
  margin: 15rpx 0 4rpx 50rpx;
  padding: 19rpx 20rpx;
  border-radius: 14rpx;
  background: linear-gradient(90deg, #f2f8f4, #f7faf8);
}

.feedback-label { color: #7c8982; font-size: 21rpx; }
.feedback-text { margin-top: 8rpx; color: #315443; font-size: 25rpx; font-weight: 600; line-height: 1.5; white-space: pre-wrap; }
.source-divider { height: 1rpx; margin: 24rpx 0 20rpx; background: #e9efeb; }
.source-title { margin-bottom: 10rpx; }

.source-content,
.source-feedback {
  margin: 10rpx 0 0 50rpx;
  padding: 18rpx 20rpx;
  border-radius: 13rpx;
  color: #3c4c44;
  background: #f5f7f6;
  font-size: 23rpx;
  line-height: 1.55;
  white-space: pre-wrap;
}

.source-feedback { margin-top: 10rpx; color: #315844; background: #eff7f2; }
.section-head { display: flex; align-items: center; justify-content: space-between; }
.section-count { color: #4a8a67; font-size: 22rpx; }
.quote-loading, .quote-empty { padding: 44rpx 10rpx 20rpx; color: #829087; font-size: 23rpx; text-align: center; }

.quote-row {
  min-height: 112rpx;
  padding: 18rpx 0;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  border-bottom: 1rpx solid #ebf0ed;
}

.quote-row:last-child { border-bottom: 0; }
.quote-main { min-width: 0; flex: 1; }
.quote-line { display: flex; align-items: baseline; min-width: 0; }
.quote-sequence { flex: none; color: #24372d; font-size: 25rpx; font-weight: 700; }
.quote-no { margin-left: 14rpx; overflow: hidden; color: #748179; font-size: 20rpx; text-overflow: ellipsis; white-space: nowrap; }
.quote-time { margin-top: 9rpx; color: #87928c; font-size: 20rpx; }
.quote-right { margin-left: 12rpx; flex: none; text-align: right; }

.quote-status {
  display: inline-block;
  padding: 5rpx 10rpx;
  border-radius: 13rpx;
  color: #19734a;
  background: #e5f4eb;
  font-size: 19rpx;
}

.quote-status.DRAFT { color: #9b6f17; background: #fff2d6; }
.quote-status.EXPIRED,
.quote-status.CLOSED { color: #6d7a73; background: #edf1ef; }
.quote-amount { margin-top: 8rpx; color: #d35a2d; font-size: 24rpx; font-weight: 700; }
.row-arrow { margin-left: 14rpx; color: #a2ada7; font-size: 34rpx; }
.create-quote { margin-top: 18rpx; color: #19734a; font-weight: 650; }

.result-card { padding-bottom: 30rpx; }
.result-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 13rpx; }

.result-option {
  min-height: 72rpx;
  padding: 12rpx 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 1rpx solid #dce6df;
  border-radius: 14rpx;
  color: #53635a;
  background: #fafbfa;
  font-size: 22rpx;
  line-height: 1.25;
  text-align: center;
}

.result-option.selected { border-color: #2b8a5a; color: #167147; background: #e8f5ed; font-weight: 700; }
.field-label { margin: 25rpx 0 13rpx; font-size: 23rpx; font-weight: 650; }

.note-input {
  width: 100%;
  height: 136rpx;
  padding: 19rpx;
  box-sizing: border-box;
  border-radius: 14rpx;
  background: #f4f7f5;
  font-size: 24rpx;
}

.datetime-row { display: flex; gap: 13rpx; }
.datetime-picker { min-width: 0; flex: 1.35; }
.time-picker { min-width: 0; flex: 1; }

.date-picker {
  width: 100%;
  height: 76rpx;
  padding: 0 18rpx;
  box-sizing: border-box;
  border-radius: 14rpx;
  background: #f2f6f3;
  color: #33463b;
  font-size: 24rpx;
  line-height: 76rpx;
}

.bottom-bar {
  position: fixed;
  z-index: 50;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 17rpx 24rpx calc(17rpx + env(safe-area-inset-bottom));
  display: flex;
  gap: 18rpx;
  box-sizing: border-box;
  border-top: 1rpx solid #e3eae5;
  background: rgba(255,255,255,.97);
  box-shadow: 0 -8rpx 24rpx rgba(30, 68, 48, .06);
}

.reschedule-button,
.submit-button {
  height: 82rpx;
  border-radius: 14rpx;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 82rpx;
  text-align: center;
}

.reschedule-button { width: 260rpx; border: 1rpx solid #59a57a; color: #24774e; background: #fff; }
.submit-button { min-width: 0; flex: 1; color: #fff; background: linear-gradient(100deg, #267e4f, #4fa540); }
.submit-button.disabled { opacity: .62; }

.sheet-mask {
  position: fixed;
  z-index: 100;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, .38);
}

.sheet {
  width: 100%;
  padding: 32rpx 28rpx calc(30rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  border-radius: 28rpx 28rpx 0 0;
  background: #fff;
}

.sheet-title { font-size: 31rpx; font-weight: 700; text-align: center; }
.sheet-hint { margin-top: 10rpx; color: #7d8982; font-size: 22rpx; text-align: center; }
.sheet-datetime { margin-top: 27rpx; }
.sheet-actions { margin-top: 28rpx; display: flex; gap: 16rpx; }
.sheet-cancel, .sheet-confirm { height: 80rpx; flex: 1; border-radius: 14rpx; font-size: 26rpx; font-weight: 650; line-height: 80rpx; text-align: center; }
.sheet-cancel { color: #5f6d65; background: #f1f4f2; }
.sheet-confirm { color: #fff; background: #247b4f; }
.loading { padding: 100rpx 30rpx; color: #849089; font-size: 25rpx; text-align: center; }
