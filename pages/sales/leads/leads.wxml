<view class="page">
  <view class="header" style="padding-top: {{statusBarHeight}}px">
    <view class="header-row">
      <view class="back" bindtap="goBack">‹</view>
      <view>
        <view class="title">跟进任务</view>
        <view class="subtitle">每一项任务都有明确结果</view>
      </view>
    </view>
  </view>

  <view class="tabs">
    <view class="tab {{activeTab === 'TODO' ? 'active' : ''}}"
      data-status="TODO" bindtap="switchTab">待办 {{todo.length}}</view>
    <view class="tab {{activeTab === 'COMPLETED' ? 'active' : ''}}"
      data-status="COMPLETED" bindtap="switchTab">已完成 {{completed.length}}</view>
  </view>

  <view class="content">
    <view class="empty" wx:if="{{!loading && visibleActions.length === 0}}">
      {{activeTab === 'TODO' ? '当前没有待办任务' : '还没有已完成任务'}}
    </view>

    <view class="task-card clickable {{item.overdue ? 'overdue' : ''}} {{focusActionId == item.actionId ? 'focused' : ''}}"
      wx:for="{{visibleActions}}" wx:key="actionId" data-id="{{item.actionId}}"
      data-status="{{item.statusCode}}" bindtap="openActionDetail">
      <view class="customer-row">
        <view class="customer-photo">
          <image wx:if="{{item.coverPhoto}}" src="{{item.coverPhoto}}" mode="aspectFill" />
          <view class="photo-placeholder" wx:else>{{item.customerInitial}}</view>
        </view>
        <view class="customer-info">
          <view class="task-head">
            <view class="task-name">{{item.customerName}}</view>
            <view class="task-status {{item.statusCode === 'COMPLETED' ? 'COMPLETED' : 'TODO'}}">
              {{item.statusCode === 'COMPLETED' ? '已完成' : '待办'}}
            </view>
          </view>
          <view class="customer-tags">
            <text class="customer-type {{item.departmentId ? 'formal' : 'prospect'}}">{{item.customerTypeLabel}}</text>
            <text class="business-type" wx:if="{{item.customerBusinessType}}">{{item.customerBusinessType}}</text>
          </view>
          <view class="customer-address">
            <text class="address-icon">址</text><text>{{item.customerAddress}}</text>
          </view>
        </view>
      </view>

      <view class="task-content">
        <view class="task-kind">{{item.actionLabel}}</view>
        <view class="task-title">{{item.displayTitle}}</view>
        <view class="task-description" wx:if="{{item.actionDescription}}">{{item.actionDescription}}</view>
      </view>
      <view class="task-meta">
        <text>{{item.statusCode === 'COMPLETED' ? '目标时间' : (item.overdue ? '已逾期' : '目标时间')}}</text>
        <text class="{{item.overdue ? 'danger' : ''}}">{{item.targetLabel}}</text>
      </view>
      <view class="task-meta" wx:if="{{item.statusCode === 'COMPLETED'}}">
        <text>完成结果</text><text class="result">{{item.resultLabel}}</text>
      </view>
      <view class="task-description" wx:if="{{item.completionNote}}">{{item.completionNote}}</view>

      <view class="task-entry" wx:if="{{item.statusCode !== 'COMPLETED'}}">
        <text>处理任务</text><text>›</text>
      </view>
      <view class="task-entry completed-entry" wx:elif="{{item.statusCode === 'COMPLETED'}}">
        <text>查看完整记录</text><text>›</text>
      </view>
    </view>
  </view>

  <view class="loading" wx:if="{{loading}}">正在加载任务…</view>
</view>
