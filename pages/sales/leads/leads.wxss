.page { width: 100%; min-height: 100vh; padding-bottom: 140rpx; overflow-x: hidden; box-sizing: border-box; background: #f4f7f5; color: #17251f; }
.header { width: 100%; padding: 26rpx 28rpx 48rpx; box-sizing: border-box; color: #fff; background: linear-gradient(135deg, #184f3a, #277452); }
.header-row { display: flex; align-items: flex-start; }
.back { width: 56rpx; height: 56rpx; margin-right: 4rpx; flex: none; color: #fff; font-size: 52rpx; line-height: 48rpx; text-align: center; }
.title { font-size: 40rpx; font-weight: 700; }
.subtitle { margin-top: 8rpx; color: rgba(255,255,255,.78); font-size: 24rpx; }
.tabs { margin: -24rpx 24rpx 20rpx; padding: 7rpx; display: flex; box-sizing: border-box; border-radius: 32rpx; background: #e5ebe7; box-shadow: 0 6rpx 18rpx rgba(24,79,58,.08); }
.tab { flex: 1; padding: 15rpx 6rpx; border-radius: 26rpx; color: #6e7a73; font-size: 23rpx; text-align: center; }
.tab.active { color: #1b6647; background: #fff; font-weight: 700; }
.content { width: 100%; padding: 0 24rpx 60rpx; box-sizing: border-box; }
.task-card { width: 100%; margin-bottom: 18rpx; padding: 22rpx; box-sizing: border-box; border: 1rpx solid #e1e9e4; border-left: 7rpx solid #d8b04f; border-radius: 19rpx; background: #fff; box-shadow: 0 5rpx 18rpx rgba(25,74,51,.04); }
.task-card.overdue { border-left-color: #d94a3d; }
.task-card.focused { box-shadow: 0 0 0 3rpx rgba(35,128,90,.18); }
.task-card.clickable:active { background: #f9fbfa; transform: scale(.997); }
.customer-row { width: 100%; display: flex; align-items: flex-start; }
.customer-photo { width: 120rpx; height: 120rpx; margin-right: 18rpx; overflow: hidden; flex: none; border-radius: 15rpx; background: #e4f0e8; }
.customer-photo image { width: 100%; height: 100%; display: block; }
.photo-placeholder { width: 100%; height: 100%; color: #317957; background: linear-gradient(145deg, #e6f2ea, #d8eade); font-size: 42rpx; font-weight: 700; line-height: 120rpx; text-align: center; }
.customer-info { min-width: 0; flex: 1; }
.task-head { display: flex; align-items: flex-start; }
.task-name { min-width: 0; overflow: hidden; flex: 1; font-size: 31rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.customer-tags { margin-top: 10rpx; display: flex; align-items: center; gap: 9rpx; }
.customer-type, .business-type { height: 38rpx; padding: 0 11rpx; display: inline-flex; align-items: center; justify-content: center; box-sizing: border-box; border-radius: 10rpx; font-size: 20rpx; line-height: 1; text-align: center; }
.customer-type.formal { color: #266f50; background: #e7f3eb; }
.customer-type.prospect { color: #9b641c; background: #fff0db; }
.business-type { color: #567065; background: #f0f4f2; }
.customer-address { min-width: 0; margin-top: 10rpx; display: flex; align-items: flex-start; color: #69776f; font-size: 21rpx; line-height: 1.45; }
.customer-address text:last-child { overflow: hidden; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.address-icon { width: 29rpx; height: 29rpx; margin-right: 7rpx; flex: none; border-radius: 8rpx; color: #3d805f; background: #edf6f0; font-size: 17rpx; line-height: 29rpx; text-align: center; }
.task-content { margin-top: 19rpx; padding-top: 17rpx; border-top: 1rpx solid #ebf0ed; }
.task-kind { display: inline-flex; padding: 5rpx 11rpx; align-items: center; border-radius: 10rpx; color: #326f54; background: #edf5f0; font-size: 21rpx; }
.task-status { padding: 8rpx 15rpx; border-radius: 18rpx; background: #fff5dc; color: #a27216; font-size: 21rpx; }
.task-status.TODO { color: #9a671c; background: #fff1d9; }
.task-status.COMPLETED { color: #64726b; background: #edf1ef; }
.task-title { margin-top: 12rpx; font-size: 28rpx; font-weight: 650; }
.task-description { margin-top: 12rpx; color: #69776f; font-size: 23rpx; line-height: 1.55; }
.task-meta { min-height: 62rpx; margin-top: 14rpx; display: flex; align-items: center; justify-content: space-between; border-top: 1rpx solid #edf1ef; color: #718078; font-size: 23rpx; }
.task-meta text:last-child { color: #2c3d34; }
.task-meta .danger { color: #d14336; font-weight: 650; }
.task-meta .result { color: #1f7652; font-weight: 650; }
.task-entry { min-height: 62rpx; margin-top: 14rpx; display: flex; align-items: flex-end; justify-content: space-between; border-top: 1rpx solid #edf1ef; color: #1e7150; font-size: 23rpx; font-weight: 650; }
.task-entry text:last-child { font-size: 38rpx; font-weight: 400; line-height: 30rpx; }
.task-entry.completed-entry { color: #65736b; }
.empty, .loading { padding: 90rpx 20rpx; color: #8b9690; text-align: center; font-size: 26rpx; }
