.page { min-height: 100vh; padding-bottom: 140rpx; background: #f4f7f5; color: #17251f; }
.header { padding: 26rpx 28rpx 42rpx; color: #fff; background: linear-gradient(135deg, #44308e, #7753c4); }
.header-row { display: flex; align-items: flex-start; }
.back { width: 56rpx; height: 56rpx; margin-right: 4rpx; flex: none; color: #fff; font-size: 52rpx; font-weight: 300; line-height: 48rpx; text-align: center; }
.title { font-size: 40rpx; font-weight: 700; }
.subtitle { margin-top: 8rpx; color: rgba(255,255,255,.78); font-size: 24rpx; }
.content { margin-top: -20rpx; padding: 0 24rpx 60rpx; }
.scope-note { padding: 22rpx; color: #635383; background: #f4effd; border: 1rpx solid #dfd4f2; border-radius: 18rpx; font-size: 22rpx; line-height: 1.55; }
.tabs { margin: 22rpx 0 16rpx; padding: 6rpx; display: flex; background: #e6ebe8; border-radius: 30rpx; }
.tab { flex: 1; padding: 13rpx 10rpx; color: #6e7a73; border-radius: 25rpx; text-align: center; font-size: 24rpx; }
.tab.active { color: #4b347f; background: #fff; font-weight: 650; box-shadow: 0 3rpx 10rpx rgba(34,49,41,.06); }
.section-note { margin: -4rpx 2rpx 16rpx; color: #8b958f; font-size: 21rpx; line-height: 1.5; }
.search { height: 80rpx; margin-bottom: 20rpx; padding: 0 24rpx; border-radius: 17rpx; background: #fff; font-size: 26rpx; }
.lead-card { margin-bottom: 18rpx; padding: 26rpx 24rpx 0; border: 1rpx solid #e4ebe7; border-radius: 19rpx; background: #fff; box-shadow: 0 5rpx 18rpx rgba(25,74,51,.04); }
.visit-card { margin-bottom: 18rpx; padding: 24rpx 24rpx 0; overflow: hidden; background: #fff; border: 1rpx solid #e4ebe7; border-radius: 19rpx; }
.visit-head { display: flex; align-items: flex-start; justify-content: space-between; }
.visit-time { margin-left: 16rpx; color: #89958e; font-size: 20rpx; }
.visit-result { margin-top: 17rpx; color: #386a55; font-size: 25rpx; font-weight: 650; }
.visit-note { margin-top: 10rpx; color: #6c7971; font-size: 23rpx; line-height: 1.5; }
.lead-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 18rpx; }
.lead-main { min-width: 0; flex: 1; }
.lead-name { font-size: 32rpx; font-weight: 700; }
.lead-type { margin-top: 8rpx; color: #77857d; font-size: 23rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.intent { width: 58rpx; height: 58rpx; border-radius: 50%; background: #eaf7f0; color: #20704e; font-size: 24rpx; line-height: 58rpx; text-align: center; }
.intent.hot { background: #fff0e3; color: #c66b20; }
.intent.cold { background: #edf2f6; color: #607180; }
.info-row { min-height: 65rpx; display: flex; align-items: center; justify-content: space-between; border-top: 1rpx solid #edf1ef; color: #65736b; font-size: 25rpx; }
.info-row text:last-child { max-width: 450rpx; color: #26372e; text-align: right; }
.info-row .important { color: #b76722; font-weight: 600; }
.card-actions { margin: 0 -24rpx; padding: 18rpx 24rpx; display: flex; gap: 14rpx; border-top: 1rpx solid #edf1ef; }
.again, .quote { flex: 1; height: 68rpx; border-radius: 34rpx; font-size: 25rpx; font-weight: 650; line-height: 68rpx; text-align: center; }
.again { background: #edf8f2; color: #176846; }
.quote { background: #fff0df; color: #a95b2d; }
.empty, .loading { padding: 80rpx 20rpx; color: #8b9690; text-align: center; font-size: 26rpx; }
