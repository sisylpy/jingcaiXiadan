.page { min-height: 100vh; background: #f4f7f5; color: #1c2923; }
.nav { height: 88rpx; padding: 0 24rpx; display: flex; align-items: center; justify-content: space-between; background: #fff; border-bottom: 1rpx solid #edf1ef; }
.back, .nav-space { width: 70rpx; }
.back { color: #176846; font-size: 54rpx; line-height: 70rpx; }
.nav-title { font-size: 32rpx; font-weight: 650; }
.content { padding: 22rpx 24rpx 50rpx; }
.section { margin-bottom: 20rpx; padding: 26rpx; background: #fff; border: 1rpx solid #e6ece8; border-radius: 20rpx; }
.section-title { margin-bottom: 20rpx; font-size: 29rpx; font-weight: 700; }
.name-field { padding: 20rpx 0; border-top: 1rpx solid #edf1ef; }
.name-field:first-of-type { border-top: 0; }
.name-label { display: block; color: #425249; font-size: 25rpx; }
.name-input { height: 72rpx; margin-top: 9rpx; padding: 0 20rpx; box-sizing: border-box; background: #f5f8f6; border: 1rpx solid #e2e9e5; border-radius: 13rpx; font-size: 28rpx; }
.name-hint, .department-hint { display: block; margin-top: 9rpx; color: #8a9690; font-size: 21rpx; line-height: 1.5; }
.row { min-height: 84rpx; display: flex; align-items: center; justify-content: space-between; border-bottom: 1rpx solid #edf1ef; font-size: 26rpx; }
.picker-value { color: #245f47; font-size: 26rpx; }
.staff { padding-top: 12rpx; }
.staff > view { min-height: 70rpx; display: flex; align-items: center; justify-content: space-between; color: #27372f; font-size: 25rpx; }
.staff-label { color: #718078; }
.staff-picker { padding: 20rpx; color: #276647; background: #edf7f1; border-radius: 12rpx; font-size: 25rpx; }
.department-mode { padding: 18rpx 0; display: flex; gap: 70rpx; border-bottom: 1rpx solid #edf1ef; }
.department-mode label { display: flex; align-items: center; font-size: 26rpx; }
.department-editor { margin-top: 10rpx; padding-top: 8rpx; border-top: 1rpx solid #edf1ef; }
.department-count { min-height: 88rpx; display: flex; align-items: center; justify-content: space-between; font-size: 26rpx; }
.count-picker { padding: 13rpx 20rpx; color: #176846; background: #edf7f1; border-radius: 25rpx; font-size: 25rpx; }
.department-input { margin-top: 15rpx; display: flex; align-items: center; }
.department-input text { width: 50rpx; color: #76847c; font-size: 25rpx; }
.department-input input { flex: 1; height: 72rpx; padding: 0 18rpx; box-sizing: border-box; background: #f5f8f6; border: 1rpx solid #e2e9e5; border-radius: 13rpx; font-size: 26rpx; }
.next-note { margin: 8rpx 6rpx 24rpx; color: #66766d; font-size: 22rpx; line-height: 1.6; }
.submit { height: 88rpx; color: #fff; line-height: 88rpx; background: #187e6e; border-radius: 44rpx; font-size: 29rpx; font-weight: 650; }
.submit::after { border: 0; }
.submit[disabled] { color: #fff; background: #a7b7b0; }
