.page { min-height: 100vh; background: #f7f4ef; color: #302a24; padding-bottom: 150rpx; }
.nav { height: 92rpx; background: #fff; display: flex; align-items: center; justify-content: space-between; padding-left: 28rpx; padding-right: 28rpx; position: sticky; top: 0; z-index: 10; }
.back { font-size: 58rpx; width: 80rpx; }
.nav-title { font-size: 32rpx; font-weight: 700; }
.retake { width: 80rpx; text-align: right; color: #597d4c; font-size: 26rpx; }
.source-card, .line-card, .search-panel { margin: 24rpx; background: #fff; border-radius: 22rpx; padding: 24rpx; box-shadow: 0 8rpx 24rpx rgba(59, 43, 27, .05); }
.source-card { display: flex; align-items: center; gap: 22rpx; }
.source-card image { width: 132rpx; height: 104rpx; border-radius: 14rpx; background: #eee; }
.source-card > view { flex: 1; }
.source-title { font-size: 28rpx; font-weight: 700; }
.source-mode { display: inline-block; margin-top: 7rpx; padding: 5rpx 10rpx; border-radius: 8rpx; color: #476e56; background: #edf5ef; font-size: 19rpx; }
.source-note { color: #8b8177; font-size: 22rpx; line-height: 1.5; margin-top: 8rpx; }
.scan-start { margin: 70rpx 28rpx; padding: 50rpx 32rpx; text-align: center; border: 2rpx dashed #acc3b1; border-radius: 24rpx; background: #fff; }
.scan-icon { width: 84rpx; height: 84rpx; margin: 0 auto; line-height: 84rpx; border-radius: 24rpx; color: #fff; background: #3f6540; font-size: 29rpx; font-weight: 700; }
.scan-title { margin-top: 22rpx; color: #2e3f35; font-size: 30rpx; font-weight: 700; }
.scan-note { margin-top: 10rpx; color: #849088; font-size: 22rpx; line-height: 1.6; }
.scan-start button { margin-top: 26rpx; height: 76rpx; line-height: 76rpx; border-radius: 38rpx; color: #fff; background: #3f6540; font-size: 24rpx; }
.loading, .error, .summary { margin: 24rpx; padding: 24rpx; border-radius: 18rpx; text-align: center; }
.loading { background: #eef4ea; color: #597d4c; }
.error { background: #fff0eb; color: #a6533d; }
.summary { background: #3f6540; color: #fff; font-weight: 700; }
.line-head, .search-head, .line-actions, .search-row, .search-candidate { display: flex; justify-content: space-between; align-items: center; }
.line-index { display: inline-flex; width: 42rpx; height: 42rpx; border-radius: 50%; background: #3f6540; color: #fff; align-items: center; justify-content: center; font-size: 22rpx; }
.raw-label { margin-left: 14rpx; color: #8b8177; font-size: 22rpx; }
.delete { color: #ad5b48; font-size: 22rpx; }
.raw-text { background: #f7f4ef; border-radius: 14rpx; padding: 20rpx; margin-top: 18rpx; font-size: 28rpx; font-weight: 600; }
.confidence { color: #91877d; font-size: 20rpx; margin-top: 10rpx; }
.edit-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; margin-top: 22rpx; }
.edit-grid > view, .private-price { background: #faf9f7; border: 1rpx solid #eee7df; border-radius: 14rpx; padding: 14rpx 18rpx; }
.edit-grid text, .private-price text { color: #877b70; font-size: 20rpx; }
.edit-grid input, .private-price input { height: 54rpx; font-size: 28rpx; }
.private-price { margin-top: 16rpx; }
.match-title { margin-top: 26rpx; font-weight: 700; }
.match-state { float: right; color: #b06c39; font-size: 22rpx; font-weight: 400; }
.match-state.ok { color: #4f7b47; }
.candidate { display: flex; align-items: center; gap: 14rpx; padding: 18rpx 0; border-bottom: 1rpx solid #eee8e1; }
.candidate.selected { background: #f1f7ed; margin: 0 -12rpx; padding-left: 12rpx; padding-right: 12rpx; border-radius: 14rpx; }
.radio { color: #52764b; font-size: 30rpx; }
.candidate image { width: 80rpx; height: 80rpx; border-radius: 12rpx; background: #eee; }
.candidate-main { flex: 1; min-width: 0; }
.candidate-name { font-size: 27rpx; font-weight: 700; }
.candidate-meta, .candidate-reason { color: #81766c; font-size: 21rpx; margin-top: 5rpx; }
.candidate-reason { color: #9b7660; }
.line-actions { color: #57784e; font-size: 24rpx; padding-top: 18rpx; }
.add-missing { margin: 24rpx; border: 2rpx dashed #719069; border-radius: 18rpx; padding: 28rpx; text-align: center; color: #55764d; background: #f3f8f0; }
.search-panel { border: 2rpx solid #dbe7d6; }
.search-head { font-weight: 700; }
.search-head text:last-child { color: #8b8177; font-weight: 400; }
.search-row { margin-top: 18rpx; background: #f5f2ee; border-radius: 14rpx; overflow: hidden; }
.search-row input { flex: 1; height: 78rpx; padding: 0 20rpx; }
.search-row view { background: #3f6540; color: #fff; height: 78rpx; line-height: 78rpx; padding: 0 28rpx; }
.searching { color: #75866f; padding: 18rpx 0; }
.search-candidate { padding: 20rpx 0; border-bottom: 1rpx solid #eee8e1; font-size: 25rpx; }
.search-candidate text { display: block; color: #8c8177; font-size: 20rpx; margin-top: 5rpx; }
.bottom-space { height: 30rpx; }
.bottom { position: fixed; left: 0; right: 0; bottom: 0; background: rgba(255,255,255,.96); padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom)); box-shadow: 0 -8rpx 24rpx rgba(45,35,25,.08); }
.bottom button { background: #3f6540; color: #fff; border-radius: 999rpx; font-weight: 700; }
.bottom button[disabled] { background: #b8c2b3; color: #fff; }
