.page { min-height: 100vh; color: #1c2b24; background: #f4f7f5; }
.header { min-height: 150rpx; padding-right: 28rpx; padding-bottom: 36rpx; padding-left: 28rpx; color: #fff; background: linear-gradient(145deg, #184f3a, #277452); }
.header-row { display: flex; align-items: flex-start; }
.back { width: 56rpx; height: 56rpx; margin-right: 4rpx; flex: none; color: #fff; font-size: 52rpx; font-weight: 300; line-height: 48rpx; text-align: center; }
.title { padding-top: 25rpx; font-size: 38rpx; font-weight: 700; }
.subtitle { margin-top: 9rpx; font-size: 23rpx; opacity: .78; }
.profile-card { margin: -20rpx 24rpx 20rpx; padding: 28rpx; display: flex; align-items: center; border-radius: 21rpx; background: #fff; box-shadow: 0 9rpx 28rpx rgba(24,79,58,.1); }
.avatar { width: 96rpx; height: 96rpx; margin-right: 22rpx; border-radius: 50%; background: #eef3f0; }
.profile-main { flex: 1; }
.name { font-size: 33rpx; font-weight: 700; }
.role { margin-top: 8rpx; color: #20704e; font-size: 23rpx; }
.section { margin: 0 24rpx 20rpx; overflow: hidden; border-radius: 19rpx; background: #fff; }
.section-title { padding: 24rpx; border-bottom: 1rpx solid #edf1ef; font-size: 28rpx; font-weight: 650; }
.row { min-height: 88rpx; margin: 0 24rpx; display: flex; align-items: center; justify-content: space-between; border-bottom: 1rpx solid #edf1ef; color: #536159; font-size: 25rpx; }
.row:last-child { border-bottom: 0; }
.row text:last-child { max-width: 430rpx; color: #26372e; text-align: right; }
.notice { margin: 0 24rpx 22rpx; padding: 22rpx; border-radius: 16rpx; color: #68766e; background: #eef5f1; font-size: 23rpx; line-height: 1.6; }
.logout { margin: 0 24rpx; height: 82rpx; color: #a54e45; background: #fff; border-radius: 41rpx; font-size: 26rpx; line-height: 82rpx; }
.logout::after { border: 0; }
.loading { padding: 80rpx; color: #87928c; text-align: center; font-size: 25rpx; }
