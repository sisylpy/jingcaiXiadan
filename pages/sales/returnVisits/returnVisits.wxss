.page { width: 100%; min-height: 100vh; overflow-x: hidden; box-sizing: border-box; color: #17251f; background: #f4f7f5; }
.header { width: 100%; min-height: 130rpx; padding-right: 28rpx; padding-bottom: 34rpx; padding-left: 28rpx; display: flex; align-items: flex-end; justify-content: space-between; box-sizing: border-box; color: #fff; background: linear-gradient(145deg, #184f3a, #277452); }
.header-left { display: flex; align-items: flex-end; }
.back { width: 56rpx; height: 56rpx; margin-right: 4rpx; flex: none; color: #fff; font-size: 52rpx; font-weight: 300; line-height: 48rpx; text-align: center; }
.title { font-size: 38rpx; font-weight: 700; }
.subtitle { margin-top: 8rpx; font-size: 23rpx; opacity: .8; }
.add { padding: 13rpx 20rpx; border: 1rpx solid rgba(255,255,255,.5); border-radius: 26rpx; font-size: 24rpx; }
.date-card { margin: -18rpx 24rpx 0; padding: 22rpx 24rpx; display: flex; align-items: center; justify-content: space-between; box-sizing: border-box; border-radius: 19rpx; background: #fff; box-shadow: 0 9rpx 25rpx rgba(24,79,58,.1); }
.date-label { color: #1d3128; font-size: 27rpx; font-weight: 700; }
.date-summary { margin-top: 7rpx; color: #7a8780; font-size: 21rpx; }
.date-value { padding: 12rpx 17rpx; border-radius: 14rpx; color: #206d4d; background: #edf7f1; font-size: 24rpx; }
.visit-list { width: 100%; padding: 24rpx; box-sizing: border-box; }
.visit-card { width: 100%; margin-bottom: 18rpx; padding: 22rpx; box-sizing: border-box; border: 1rpx solid #e1e9e4; border-radius: 20rpx; background: #fff; box-shadow: 0 5rpx 18rpx rgba(25,74,51,.045); }
.customer-row { width: 100%; display: flex; align-items: flex-start; }
.customer-photo { width: 122rpx; height: 122rpx; margin-right: 18rpx; overflow: hidden; flex: none; border-radius: 15rpx; background: #e4f0e8; }
.customer-photo image { width: 100%; height: 100%; display: block; }
.photo-placeholder { width: 100%; height: 100%; color: #317957; background: linear-gradient(145deg, #e6f2ea, #d8eade); font-size: 42rpx; font-weight: 700; line-height: 122rpx; text-align: center; }
.customer-info { min-width: 0; flex: 1; }
.card-head { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; }
.customer-name { min-width: 0; overflow: hidden; font-size: 30rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.subject-arrow { width: 20rpx; margin-left: 8rpx; flex: none; color: #9aa59f; font-size: 36rpx; line-height: 40rpx; }
.status { flex: none; padding: 7rpx 14rpx; border-radius: 18rpx; font-size: 21rpx; }
.status.done { color: #47705d; background: #edf3f0; }
.status.following { color: #9b641c; background: #fff0db; }
.customer-tags { margin-top: 11rpx; display: flex; align-items: center; gap: 10rpx; }
.customer-type, .business-type {
  height: 38rpx;
  padding: 0 11rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border-radius: 10rpx;
  font-size: 20rpx;
  line-height: 1;
  text-align: center;
}
.customer-type.formal { color: #266f50; background: #e7f3eb; }
.customer-type.prospect { color: #9b641c; background: #fff0db; }
.business-type { color: #567065; background: #f0f4f2; }
.customer-address { min-width: 0; margin-top: 11rpx; display: flex; align-items: flex-start; color: #68776f; font-size: 21rpx; line-height: 1.45; }
.customer-address text:last-child { overflow: hidden; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.address-icon { width: 29rpx; height: 29rpx; margin-right: 7rpx; flex: none; border-radius: 8rpx; color: #3d805f; background: #edf6f0; font-size: 17rpx; line-height: 29rpx; text-align: center; }
.visit-record { margin-top: 19rpx; padding-top: 17rpx; border-top: 1rpx solid #ebf0ed; }
.visit-meta { display: flex; align-items: center; gap: 14rpx; color: #78857e; font-size: 22rpx; }
.visit-time { color: #475b50; font-weight: 650; }
.feedback { color: #277052; }
.visit-type { padding: 5rpx 10rpx; border-radius: 10rpx; color: #49695a; background: #edf4f0; }
.summary { margin-top: 14rpx; padding: 16rpx 18rpx; border-radius: 13rpx; color: #43534b; background: #f4f7f5; font-size: 23rpx; line-height: 1.55; }
.empty-summary { color: #929b96; }
.follow-row { margin-top: 16rpx; padding-top: 15rpx; display: flex; justify-content: space-between; border-top: 1rpx solid #edf1ef; color: #20704e; font-size: 22rpx; }
.announcement { display: inline-block; margin-top: 14rpx; padding: 7rpx 13rpx; border-radius: 12rpx; color: #426d59; background: #e8f4ed; font-size: 21rpx; }
.card-actions { margin-top: 18rpx; display: flex; justify-content: flex-end; gap: 28rpx; color: #62736a; font-size: 23rpx; }
.card-actions .primary-action { color: #16704c; font-weight: 650; }
.empty, .loading { padding: 120rpx 30rpx; color: #89948e; text-align: center; font-size: 26rpx; }
.empty-note { margin-top: 14rpx; font-size: 22rpx; }
