.page { min-height: 100vh; padding-bottom: 40rpx; background: #fff; color: #203028; }
.header { padding: 26rpx 28rpx 48rpx; color: #fff; background: linear-gradient(135deg, #075d43, #0b8060); }
.header-row { display: flex; align-items: center; }
.back { width: 56rpx; height: 56rpx; flex: none; color: #fff; font-size: 52rpx; font-weight: 300; line-height: 48rpx; text-align: center; }
.header-titles { min-width: 0; flex: 1; }
.title { font-size: 40rpx; font-weight: 700; }
.subtitle { margin-top: 8rpx; color: rgba(255,255,255,.78); font-size: 24rpx; }
.content { margin-top: -24rpx; padding: 0 0 40rpx; }
.quote-bar { padding: 20rpx 24rpx 0; display: flex; align-items: center; justify-content: space-between; background: #fff; }
.plus-btn { width: 56rpx; height: 56rpx; flex: none; color: #fff; background: #0b8060; border-radius: 50%; font-size: 40rpx; font-weight: 400; line-height: 52rpx; text-align: center; box-shadow: 0 6rpx 16rpx rgba(11,128,96,.35); }
.section-title { color: #25342d; font-size: 30rpx; font-weight: 700; }
.tabs { margin-top: 6rpx; padding: 0 24rpx; display: flex; }
.tab { flex: 1; padding: 20rpx 0 16rpx; color: #718078; font-size: 28rpx; font-weight: 500; text-align: center; position: relative; }
.tab.active { color: #176846; font-weight: 700; }
.tab.active::after { content: ''; position: absolute; left: 50%; bottom: 0; width: 56rpx; height: 6rpx; margin-left: -28rpx; border-radius: 3rpx; background: #176846; }
.quote-swiper { margin-top: 4rpx; }
.quote-scroll { width: 100%; }
.quote-card { margin: 0 24rpx; padding: 24rpx 4rpx; display: flex; align-items: center; background: #fff; border-bottom: 1rpx solid #eef1ef; }
.quote-index { width: 48rpx; flex: none; color: #9aa59f; font-size: 26rpx; font-weight: 500; }
.quote-main { min-width: 0; flex: 1; }
.target-line { display: flex; align-items: center; min-width: 0; }
.target-type { flex: none; margin-right: 10rpx; padding: 5rpx 10rpx; border-radius: 8rpx; color: #216a4b; background: #eaf5ef; font-size: 19rpx; }
.quote-name { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 28rpx; font-weight: 650; }
.quote-meta { margin-top: 8rpx; color: #849088; font-size: 21rpx; }
.quote-time { margin-top: 6rpx; color: #a0a9a3; font-size: 19rpx; }
.quote-side { margin-left: 14rpx; text-align: right; }
.quote-status { color: #277253; font-size: 22rpx; }
.quote-amount { margin-top: 7rpx; color: #cb5f2e; font-size: 23rpx; }
.quote-delete { margin-top: 10rpx; color: #b45f4d; font-size: 20rpx; }
.arrow { margin-left: 14rpx; color: #9ba59f; font-size: 38rpx; }
.empty, .loading { padding: 70rpx 20rpx; color: #8c9891; text-align: center; font-size: 25rpx; }
