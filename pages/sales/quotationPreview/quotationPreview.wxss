.page { min-height: 100vh; background: #eef1ee; color: #223129; }
.nav { height: 92rpx; padding: 0 24rpx; display: flex; align-items: center; background: #fff; }
.back, .nav-space { width: 72rpx; font-size: 58rpx; color: #315f4c; }
.nav-title { flex: 1; text-align: center; font-size: 32rpx; font-weight: 650; }
.paper { margin: 24rpx 18rpx; overflow: hidden; border-radius: 18rpx; background: #fff; box-shadow: 0 8rpx 28rpx rgba(30, 55, 43, .10); }
.paper-head { position: relative; min-height: 210rpx; overflow: hidden; color: #fff; background: #176b4d; }
.paper-head:not(.has-banner) { min-height: 190rpx; }
.paper-banner { position: absolute; inset: 0; width: 100%; height: 100%; }
.paper-banner-mask { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(3,43,27,.94), rgba(3,43,27,.55) 60%, rgba(3,43,27,.10)); }
.paper-head-copy { position: relative; z-index: 2; padding: 34rpx 30rpx 28rpx; }
.paper-title { max-width: 76%; font-size: 36rpx; font-weight: 750; letter-spacing: 1rpx; }
.paper-subtitle { margin-top: 12rpx; color: rgba(255,255,255,.84); font-size: 21rpx; }
.shop { margin-top: 25rpx; font-size: 24rpx; }
.valid { margin-top: 8rpx; color: rgba(255,255,255,.74); font-size: 21rpx; }
.quote-catalog { height: 930rpx; display: flex; overflow: hidden; background: #fff; }
.great-category-list { width: 138rpx; height: 100%; flex: none; background: #f1f3f1; }
.great-category { min-height: 108rpx; padding: 18rpx 10rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; box-sizing: border-box; color: #6d756f; text-align: center; border-left: 5rpx solid transparent; border-bottom: 1rpx solid #e3e7e4; font-size: 25rpx; line-height: 1.25; }
.great-category.active { color: #176a4b; background: #fff; border-left-color: #1d805a; font-weight: 650; }
.great-category-name { word-break: break-all; }
.great-category-count { margin-top: 5rpx; color: #8b938e; font-size: 20rpx; font-weight: 400; }
.catalog-main { min-width: 0; min-height: 0; display: flex; flex: 1; flex-direction: column; background: #f5f7f5; }
.sub-category-scroll { width: 100%; height: 84rpx; flex: none; white-space: nowrap; background: #fff; border-bottom: 1rpx solid #e5e9e6; }
.sub-category-row { height: 84rpx; padding: 0 14rpx; display: inline-flex; align-items: center; box-sizing: border-box; }
.sub-category { margin-right: 12rpx; padding: 10rpx 15rpx; color: #4f5d55; background: #fff; border: 1rpx solid #cdd4cf; border-radius: 8rpx; font-size: 22rpx; line-height: 1; }
.sub-category.active { color: #fff; background: #1e7855; border-color: #1e7855; }
.goods-scroll { width: 100%; min-height: 0; flex: 1; }
.goods-list { padding: 13rpx; }
.goods-card { margin-bottom: 13rpx; padding: 16rpx; display: flex; background: #fff; border-radius: 15rpx; box-shadow: 0 3rpx 12rpx rgba(34, 70, 53, .05); }
.goods-image { width: 108rpx; height: 108rpx; flex: none; border-radius: 11rpx; background: #edf0ed; }
.goods-main { min-width: 0; margin-left: 14rpx; flex: 1; }
.goods-name { font-size: 29rpx; font-weight: 650; }
.goods-meta { margin-top: 6rpx; overflow: hidden; color: #78847d; text-overflow: ellipsis; white-space: nowrap; font-size: 21rpx; }
.price { margin-top: 12rpx; color: #c85226; font-size: 26rpx; font-weight: 650; }
.goods-tail { height: 20rpx; }
.empty { padding: 80rpx 30rpx; text-align: center; color: #8a958e; }
.privacy { padding: 24rpx 20rpx 28rpx; text-align: center; color: #939c96; font-size: 20rpx; border-top: 1rpx solid #edf0ee; }
.loading { padding: 80rpx; text-align: center; color: #77837b; }
