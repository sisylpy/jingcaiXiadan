.page { min-height: 100vh; background: #f5f7f6; }
.loading, .load-failed { padding: 240rpx 32rpx 80rpx; color: #849088; text-align: center; font-size: 26rpx; }
.retry { width: 240rpx; height: 76rpx; margin: 34rpx auto 0; border-radius: 38rpx; color: #fff; background: #20704e; line-height: 76rpx; }
.back { margin-top: 28rpx; color: #20704e; }
