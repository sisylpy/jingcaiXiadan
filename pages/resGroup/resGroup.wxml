<view class="page">
  <view class="top_bar page-nav" style="padding-top: {{statusBarHeight}}rpx;">
    <image src="/images/back.png" class="top_back_img" bindtap="toBack"></image>
    <text class="top_bar_title_small">设置</text>
  </view>

  <scroll-view scroll-y class="page-scroll" style="padding-top: {{90 + statusBarHeight}}rpx;">
    <view class="content" id="mjltest">
      <view class="merchant-card">
        <view class="merchant-head">
          <image class="merchant-logo" src="{{disInfo.nxDistributerImg ? url + disInfo.nxDistributerImg : '/images/logo.png'}}" mode="aspectFill"></image>
          <view class="merchant-main">
            <text class="merchant-name">{{disInfo.nxDistributerName}}</text>
            <text class="merchant-sub">餐饮食材配送 / 批发订货</text>
          </view>
        </view>

        <view class="merchant-info">
          <view class="info-row">
            <text class="info-icon">☎</text>
            <text class="info-label">联系电话</text>
            <text class="info-value">{{disInfo.nxDistributerPhone || '—'}}</text>
          </view>
          <view class="info-row">
            <text class="info-icon">▣</text>
            <text class="info-label">市场</text>
            <text class="info-value">{{disInfo.nxDistributerMarketName}}</text>
          </view>
          <view class="info-row">
            <text class="info-icon">●</text>
            <text class="info-label">地址</text>
            <text class="info-value">{{disInfo.nxDistributerAddress || '—'}}</text>
          </view>
        </view>
      </view>

      <view class="section-card action-section">
        <view class="action-grid">
          <button class="action-item action-green clear-button" open-type="share" data-type="1" bindtap="toSharePurchase">
            <text class="action-icon">邀</text>
            <view class="action-text">
              <text class="action-title">邀请同事</text>
              <text class="action-desc">邀请同事一起订货</text>
            </view>
            <text class="action-arrow">›</text>
          </button>
          <view class="action-item action-blue" bindtap="openBillList" hover-class="hover">
            <text class="action-icon">单</text>
            <view class="action-text">
              <text class="action-title">历史订单</text>
              <text class="action-desc">查看过往订单记录</text>
            </view>
            <text class="action-arrow">›</text>
          </view>
          <view class="action-item action-orange" bindtap="toCouponList" hover-class="hover">
            <text class="action-icon">券</text>
            <view class="action-text">
              <text class="action-title">优惠券</text>
              <text class="action-desc">查看可用优惠券</text>
            </view>
            <text class="action-arrow">›</text>
          </view>
          <view class="action-item action-purple" bindtap="toPurchaseAnalysis" hover-class="hover">
            <text class="action-icon">析</text>
            <view class="action-text">
              <text class="action-title">采购分析</text>
              <text class="action-desc">统计订货情况</text>
            </view>
            <text class="action-arrow">›</text>
          </view>
        </view>
      </view>

      <view class="section-card member-card">
        <view class="section-title-row">
          <view>
            <text class="section-title">订货员</text>
            <text class="member-count">{{userArr.length || 0}} 人</text>
          </view>
          <text class="section-desc">离职员工可删除账号</text>
        </view>

        <view class="member-list">
          <view class="member-row" wx:for="{{userArr}}" wx:key="nxDepartmentUserId">
            <image class="member-avatar" src="{{item.nxDuUrlChange == 1 ? url + item.nxDuWxAvartraUrl : item.nxDuWxAvartraUrl}}" mode="aspectFill"></image>
            <view class="member-info">
              <view class="member-name-row">
                <text class="member-name">{{item.nxDuWxNickName || '未命名用户'}}</text>
                <text wx:if="{{item.nxDepartmentUserId == userInfo.nxDepartmentUserId}}" class="self-tag">你自己</text>
              </view>
              <text class="member-role">{{item.nxDuAdmin == 1 ? '管理人员' : '订货员'}}</text>
            </view>
            <view class="member-more" bindtap="openOperation" data-id="{{item.nxDepartmentUserId}}" hover-class="hover">
              <text>···</text>
            </view>
          </view>
        </view>
      </view>

      <view class="version">版本 0.0.1</view>
    </view>
  </scroll-view>
</view>

<view class="mask {{showOperation ? 'is-active' : ''}}" catchtap="hideMask" catchtouchmove="true">
  <view class="operation-sheet" catchtap="noop">
    <view class="sheet-handle"></view>
    <view wx:if="{{selectUserId == userInfo.nxDepartmentUserId}}" class="operation-row" bindtap="editUser">
      <text class="operation-title">修改我的信息</text>
      <text class="operation-sub">头像、昵称等资料</text>
    </view>
    <view wx:else class="operation-row danger" bindtap="delUser">
      <text class="operation-title">删除订货员</text>
      <text class="operation-sub">员工离职后可移除账号</text>
    </view>
    <view class="operation-cancel" bindtap="hideMask">取消</view>
  </view>
</view>

<view class="mask {{isTishi ? 'is-active' : ''}}">
  <view class="tip-card">
    <text class="tip-title">邀请已发送</text>
    <text class="tip-desc">收到邀请并注册成功的用户，会显示在订货员列表中。</text>
    <view class="tip-button" bindtap="closeMask">我知道了</view>
  </view>
</view>
