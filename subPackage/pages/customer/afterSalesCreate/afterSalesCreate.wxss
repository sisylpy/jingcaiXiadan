.page { min-height: 100vh; padding-bottom: 46rpx; color: #17251f; background: #f3f6f4; }
.header { min-height: 142rpx; padding-right: 28rpx; padding-bottom: 34rpx; padding-left: 24rpx; box-sizing: border-box; color: #fff; background: linear-gradient(145deg, #174c38, #247653); }
.header-row { display: flex; align-items: flex-end; }
.back { width: 58rpx; height: 58rpx; margin-right: 4rpx; font-size: 54rpx; font-weight: 300; line-height: 50rpx; text-align: center; }
.title { font-size: 37rpx; font-weight: 720; }
.subtitle { margin-top: 8rpx; font-size: 23rpx; opacity: .78; }
.source-card { margin: -18rpx 24rpx 18rpx; padding: 24rpx; border-radius: 20rpx; background: #fff; box-shadow: 0 10rpx 28rpx rgba(24,79,58,.1); }
.source-customer { font-size: 30rpx; font-weight: 720; }
.source-meta { margin-top: 8rpx; color: #78867e; font-size: 22rpx; }
.form-card { margin: 0 24rpx 16rpx; padding: 24rpx; border-radius: 19rpx; background: #fff; }
.form-title-row { display: flex; align-items: center; justify-content: space-between; }
.form-title { margin-bottom: 18rpx; font-size: 27rpx; font-weight: 700; }
.form-title-row .form-title { margin-bottom: 0; }
.scope-note, .photo-count { color: #849088; font-size: 20rpx; }
.option-grid { display: flex; flex-wrap: wrap; margin-right: -10rpx; }
.option { min-width: 116rpx; margin: 0 10rpx 12rpx 0; padding: 13rpx 14rpx; box-sizing: border-box; border: 1rpx solid #dfe7e2; border-radius: 13rpx; color: #65736b; background: #fafcfb; font-size: 22rpx; text-align: center; }
.option.selected { border-color: #277a58; color: #176c4b; background: #eaf5ef; font-weight: 650; }
.scope-options { margin-top: 18rpx; display: flex; }
.scope-option { margin-right: 12rpx; padding: 16rpx 24rpx; border: 1rpx solid #dce5df; border-radius: 14rpx; color: #6c7972; font-size: 23rpx; }
.scope-option.selected { border-color: #277a58; color: #176c4b; background: #eaf5ef; }
.order-scope { margin-top: 18rpx; padding: 22rpx; border-radius: 14rpx; color: #317557; background: #edf6f1; font-size: 23rpx; }
.item-hint { margin: 18rpx 0 12rpx; color: #819087; font-size: 21rpx; }
.order-option { margin-top: 10rpx; padding: 18rpx; display: flex; align-items: center; border: 1rpx solid #e0e7e3; border-radius: 14rpx; }
.order-option.selected { border-color: #2d7d5d; background: #f1f8f4; }
.check { width: 38rpx; height: 38rpx; margin-right: 14rpx; border: 2rpx solid #a5b2ab; border-radius: 50%; color: #fff; font-size: 23rpx; line-height: 38rpx; text-align: center; }
.order-option.selected .check { border-color: #277a58; background: #277a58; }
.order-copy { min-width: 0; flex: 1; }
.order-name { font-size: 25rpx; font-weight: 650; }
.order-quantity { margin-top: 5rpx; color: #7d8982; font-size: 21rpx; }
.severity-grid { display: flex; }
.severity { margin-right: 12rpx; padding: 15rpx 30rpx; border: 1rpx solid #e0e6e2; border-radius: 15rpx; color: #6e7a73; font-size: 23rpx; }
.severity.selected { border-color: #d5a83d; color: #8a6410; background: #fff7df; }
.severity.severity-LIGHT { border-color: #77aa91; color: #267251; background: #edf7f2; }
.severity.severity-SERIOUS { border-color: #e07b63; color: #b3412c; background: #fff0ec; }
.description { width: 100%; height: 190rpx; padding: 20rpx; box-sizing: border-box; border-radius: 14rpx; background: #f5f7f6; font-size: 25rpx; }
.photo-target { margin-top: 18rpx; padding: 16rpx; border-radius: 12rpx; color: #36775d; background: #eff6f2; font-size: 22rpx; }
.photo-grid { margin-top: 18rpx; display: flex; flex-wrap: wrap; }
.photo-item, .photo-add { position: relative; width: 190rpx; height: 190rpx; margin: 0 14rpx 14rpx 0; overflow: hidden; border-radius: 14rpx; }
.photo-item image { width: 100%; height: 100%; }
.photo-label { position: absolute; right: 0; bottom: 0; left: 0; padding: 7rpx; overflow: hidden; color: #fff; background: rgba(0,0,0,.52); font-size: 18rpx; text-align: center; text-overflow: ellipsis; white-space: nowrap; }
.photo-remove { position: absolute; top: 7rpx; right: 7rpx; width: 36rpx; height: 36rpx; border-radius: 50%; color: #fff; background: rgba(0,0,0,.55); font-size: 28rpx; line-height: 33rpx; text-align: center; }
.photo-status { position: absolute; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: center; justify-content: center; color: #fff; background: rgba(0,0,0,.58); font-size: 21rpx; }
.photo-add { display: flex; flex-direction: column; align-items: center; justify-content: center; border: 2rpx dashed #b9c7bf; box-sizing: border-box; color: #708078; background: #f8faf9; font-size: 21rpx; }
.photo-plus { margin-bottom: 8rpx; font-size: 45rpx; font-weight: 300; }
.save { height: 88rpx; margin: 28rpx 24rpx 0; border-radius: 44rpx; color: #fff; background: #1f7b57; font-size: 29rpx; font-weight: 700; line-height: 88rpx; }
.save[disabled] { color: rgba(255,255,255,.7); background: #78a792; }
