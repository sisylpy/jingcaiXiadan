page { background: #f3f6f4; }
.page { min-height: 100vh; box-sizing: border-box; color: #203028; background: #f3f6f4; }
.nav { min-height: 92rpx; padding-right: 24rpx; padding-left: 20rpx; display: flex; align-items: center; box-sizing: content-box; background: #fff; border-bottom: 1rpx solid #e8ece9; }
.back { width: 64rpx; flex: none; color: #315f4c; font-size: 58rpx; line-height: 1; }
.nav-copy { flex: 1; min-width: 0; text-align: center; }
.nav-title { font-size: 31rpx; font-weight: 700; }
.nav-subtitle { margin-top: 4rpx; overflow: hidden; color: #75827a; font-size: 19rpx; text-overflow: ellipsis; white-space: nowrap; }
.basket-count { width: 88rpx; flex: none; color: #176b4d; font-size: 20rpx; text-align: right; }
.input-stage, .review-stage { width: 100%; padding: 14rpx 22rpx 40rpx; box-sizing: border-box; }
.hero-card { height: 84rpx; padding: 0 20rpx; display: flex; align-items: center; justify-content: space-between; border-radius: 18rpx; color: #fff; background: linear-gradient(100deg, #087558, #2fa98e); }
.hero-brand { display: flex; align-items: center; gap: 12rpx; font-size: 25rpx; font-weight: 700; }
.hero-brand > text { width: 45rpx; height: 45rpx; display: flex; align-items: center; justify-content: center; border-radius: 12rpx; color: #087558; background: #dff7ee; font-size: 20rpx; }
.industry-link { padding: 10rpx 14rpx; border: 1rpx solid rgba(255,255,255,.36); border-radius: 18rpx; font-size: 20rpx; }
.business-panel { margin-top: 14rpx; padding: 19rpx; border-radius: 18rpx; background: #fff; }
.business-head { display: flex; align-items: center; justify-content: space-between; font-size: 24rpx; font-weight: 650; }
.business-head view { color: #718078; font-size: 20rpx; font-weight: 400; }
.business-types { margin-top: 15rpx; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10rpx; }
.business-type { min-width: 0; padding: 13rpx 5rpx; display: flex; flex-direction: column; align-items: center; border: 1rpx solid #dce8e1; border-radius: 13rpx; color: #3f574a; font-size: 20rpx; }
.business-type image { width: 42rpx; height: 42rpx; margin-bottom: 6rpx; }
.business-type text { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 100%; }
.panel-empty { padding: 26rpx 0 8rpx; color: #8b968f; text-align: center; font-size: 21rpx; }
.editor-card { margin-top: 16rpx; overflow: hidden; border: 1rpx solid #dce5e0; border-radius: 20rpx; background: #fff; box-shadow: 0 4rpx 14rpx rgba(22,65,47,.04); }
.editor-card.recording { border-color: #5ab79a; box-shadow: 0 0 0 3rpx rgba(42,155,119,.1); }
.editor-header { height: 70rpx; padding: 0 20rpx; display: flex; align-items: center; justify-content: space-between; font-size: 25rpx; font-weight: 700; }
.editor-header view { color: #187353; font-size: 21rpx; font-weight: 500; }
.goods-textarea { width: 100%; height: 560rpx; padding: 4rpx 20rpx 20rpx; box-sizing: border-box; color: #25392f; font-size: 27rpx; line-height: 1.7; }
.record-status { min-height: 52rpx; padding: 0 20rpx; display: flex; align-items: center; justify-content: space-between; color: #66786e; background: #eef5f1; font-size: 20rpx; }
.record-status.active { color: #087557; background: #e0f4ec; }
.source-actions { margin-top: 16rpx; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12rpx; }
.source-action { height: 116rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; border: 1rpx solid #d7e1dc; border-radius: 17rpx; color: #35483e; background: #fff; font-size: 21rpx; }
.source-action.primary { border-color: #75cdb3; color: #087557; background: #edfaf6; }
.source-action.active { color: #b13b31; background: #fff0ef; }
.source-icon { width: 43rpx; height: 43rpx; margin-bottom: 8rpx; display: flex; align-items: center; justify-content: center; border-radius: 12rpx; font-size: 19rpx; font-weight: 700; }
.source-icon.voice { color: #ca554b; background: #fff0ef; }
.source-icon.paste { color: #087557; background: #dff5ec; }
.source-icon.image { color: #5f57b5; background: #f0efff; }
.parse-button { height: 82rpx; margin-top: 16rpx; padding: 0 25rpx; display: flex; align-items: center; justify-content: space-between; border-radius: 18rpx; color: #fff; background: linear-gradient(100deg, #0b7758, #299977); font-size: 25rpx; font-weight: 700; }
.parse-button.disabled { color: rgba(255,255,255,.8); background: #accbc0; }
.price-note { margin-top: 13rpx; color: #7b8880; text-align: center; font-size: 20rpx; }
.existing-basket-bar { height: 78rpx; margin-top: 18rpx; padding: 0 24rpx; display: flex; align-items: center; justify-content: space-between; border-radius: 39rpx; color: #fff; background: #174f3d; box-shadow: 0 8rpx 22rpx rgba(16,65,47,.16); font-size: 22rpx; }
.existing-basket-bar view { font-weight: 650; }
.review-stage { padding-bottom: 135rpx; }
.review-head { padding: 10rpx 4rpx 16rpx; display: flex; align-items: flex-start; justify-content: space-between; }
.review-title { font-size: 32rpx; font-weight: 750; }
.review-head text { display: block; margin-top: 6rpx; color: #7a8780; font-size: 21rpx; }
.edit-source { padding: 11rpx 16rpx; border: 1rpx solid #bad6c8; border-radius: 17rpx; color: #176b4d; font-size: 21rpx; }
.summary-card { padding: 18rpx 0; display: grid; grid-template-columns: repeat(3, 1fr); border-radius: 18rpx; background: #fff; }
.summary-card > view { display: flex; flex-direction: column; align-items: center; border-right: 1rpx solid #e8ece9; }
.summary-card > view:last-child { border-right: 0; }
.summary-card text { color: #176b4d; font-size: 32rpx; font-weight: 750; }
.summary-card label { margin-top: 4rpx; color: #7d8982; font-size: 19rpx; }
.review-card { margin-top: 15rpx; padding: 18rpx; border: 1rpx solid #dce7e1; border-radius: 18rpx; background: #fff; }
.review-card.needs-match { border-color: #efcf8f; }
.review-card-head { display: flex; align-items: center; }
.sequence { width: 42rpx; height: 42rpx; flex: none; display: flex; align-items: center; justify-content: center; border-radius: 50%; color: #fff; background: #2b8c68; font-size: 20rpx; font-weight: 700; }
.raw-text { flex: 1; min-width: 0; margin-left: 11rpx; overflow: hidden; color: #79857e; font-size: 20rpx; text-overflow: ellipsis; white-space: nowrap; }
.delete { flex: none; margin-left: 10rpx; color: #b45f50; font-size: 20rpx; }
.match-search { height: 88rpx; margin-top: 14rpx; display: flex; }
.match-search input { min-width: 0; height: 88rpx; flex: 1; padding: 0 18rpx; box-sizing: border-box; border-radius: 12rpx 0 0 12rpx; background: #f3f6f4; font-size: 25rpx; }
.match-search .search-button { width: 90rpx; flex: none; display: flex; align-items: center; justify-content: center; border-radius: 0 12rpx 12rpx 0; color: #fff; background: #287653; font-size: 21rpx; }
.match-search .create-goods-button { width: 72rpx; flex: none; margin-left: 10rpx; display: flex; align-items: center; justify-content: center; border: 1rpx solid #91c7b0; border-radius: 50%; color: #176b4d; background: #fff; font-size: 38rpx; font-weight: 400; }
.selected-goods { margin-top: 14rpx; display: flex; align-items: center; }
.selected-goods > image { width: 90rpx; height: 90rpx; flex: none; border-radius: 13rpx; background: #eef1ef; }
.selected-main { min-width: 0; flex: 1; margin-left: 13rpx; }
.selected-name { overflow: hidden; font-size: 27rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.selected-meta { margin-top: 5rpx; color: #7d8982; font-size: 20rpx; }
.match-reason { margin-top: 5rpx; color: #2f785a; font-size: 19rpx; }
.change-match { flex: none; margin-left: 8rpx; padding: 9rpx 12rpx; border-radius: 16rpx; color: #176b4d; background: #edf7f2; font-size: 19rpx; }
.change-match.editing { color: #7a6558; background: #f4f1ef; }
.candidate-list { margin-top: 14rpx; padding: 8rpx 12rpx; border-radius: 14rpx; background: #f3f6f4; }
.candidate { padding: 10rpx 0; display: flex; align-items: center; border-bottom: 1rpx solid #e0e7e3; }
.candidate:last-child { border-bottom: 0; }
.candidate.selected { color: #176b4d; }
.candidate image { width: 62rpx; height: 62rpx; border-radius: 10rpx; }
.candidate > view { min-width: 0; flex: 1; margin-left: 12rpx; display: flex; justify-content: space-between; }
.candidate text { font-size: 22rpx; font-weight: 650; }
.candidate label { color: #d15d2b; font-size: 20rpx; }
.edit-grid { margin-top: 15rpx; display: grid; grid-template-columns: .8fr .8fr 1.4fr; gap: 10rpx; }
.edit-grid > view { min-width: 0; padding: 12rpx; border-radius: 12rpx; background: #f4f7f5; }
.edit-grid text { display: block; color: #7b8780; font-size: 18rpx; }
.edit-grid input { width: 100%; height: 46rpx; margin-top: 4rpx; box-sizing: border-box; font-size: 24rpx; }
.price-field input { color: #d15d2b; font-weight: 700; }
.add-line { margin-top: 16rpx; height: 70rpx; display: flex; align-items: center; justify-content: center; border: 1rpx dashed #9bc7b3; border-radius: 16rpx; color: #176b4d; background: #f6fbf8; font-size: 22rpx; }
.review-tail { height: 10rpx; }
.review-bottom { position: fixed; right: 0; bottom: 0; left: 0; padding: 17rpx 22rpx 28rpx; display: flex; align-items: center; gap: 15rpx; box-sizing: border-box; background: #fff; box-shadow: 0 -5rpx 20rpx rgba(0,0,0,.07); z-index: 20; }
.review-count { flex: 1; color: #596c62; font-size: 22rpx; }
.confirm-add { height: 76rpx; padding: 0 38rpx; display: flex; align-items: center; justify-content: center; border-radius: 38rpx; color: #fff; background: #176b4d; font-size: 24rpx; font-weight: 700; }
.matching-mask { position: fixed; inset: 0; display: flex; align-items: center; justify-content: center; background: rgba(255,255,255,.82); z-index: 99; }
.matching-card { display: flex; flex-direction: column; align-items: center; color: #176b4d; font-size: 23rpx; }
.matching-orb { width: 76rpx; height: 76rpx; margin-bottom: 18rpx; display: flex; align-items: center; justify-content: center; border-radius: 24rpx; color: #fff; background: #16805d; font-size: 25rpx; font-weight: 750; animation: pulse 1.1s infinite ease-in-out; }
@keyframes pulse { 0%,100% { transform: scale(.92); opacity: .75; } 50% { transform: scale(1.08); opacity: 1; } }
