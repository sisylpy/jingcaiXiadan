page { background: #f3f6f4; }
.page { width: 100%; min-height: 100vh; padding-bottom: 150rpx; box-sizing: border-box; overflow-x: hidden; color: #203028; background: #f3f6f4; }
.page view, .page input, .page textarea { box-sizing: border-box; }
.nav { min-height: 92rpx; padding-right: 24rpx; padding-left: 20rpx; display: flex; align-items: center; box-sizing: content-box; background: #fff; border-bottom: 1rpx solid #e7ece9; }
.back { width: 72rpx; flex: none; color: #315f4c; font-size: 58rpx; line-height: 1; }
.nav-title { min-width: 0; flex: 1; text-align: center; font-size: 32rpx; font-weight: 700; }
.nav-space { width: 72rpx; flex: none; }
.intro { width: calc(100% - 44rpx); margin: 20rpx 22rpx 0; padding: 22rpx; border-radius: 18rpx; color: #fff; background: linear-gradient(105deg, #176b4d, #299575); }
.intro-title { font-size: 27rpx; font-weight: 700; }
.intro-note { margin-top: 8rpx; color: rgba(255,255,255,.82); font-size: 20rpx; }
.form-card { width: calc(100% - 44rpx); margin: 18rpx 22rpx 0; padding: 8rpx 20rpx; border-radius: 18rpx; background: #fff; }
.section-label { padding: 18rpx 0 8rpx; color: #176b4d; font-size: 22rpx; font-weight: 700; }
.field-row { min-height: 92rpx; display: flex; align-items: center; border-bottom: 1rpx solid #edf0ee; }
.field-row:last-child { border-bottom: 0; }
.field-row > text { width: 150rpx; flex: none; color: #65746c; font-size: 22rpx; }
.field-row input { min-width: 0; height: 92rpx; flex: 1; font-size: 25rpx; }
.photo-card { padding-top: 20rpx; padding-bottom: 20rpx; }
.photo-head { display: flex; align-items: center; justify-content: space-between; font-size: 24rpx; font-weight: 700; }
.photo-head view { color: #76847c; font-size: 20rpx; font-weight: 400; }
.photo-note { margin-top: 7rpx; color: #859088; font-size: 19rpx; }
.photo-grid { margin-top: 17rpx; display: flex; gap: 15rpx; }
.photo-item, .photo-add { position: relative; width: 150rpx; height: 150rpx; flex: none; overflow: hidden; border-radius: 15rpx; }
.photo-item image { width: 100%; height: 100%; }
.photo-remove { position: absolute; top: 7rpx; right: 7rpx; width: 38rpx; height: 38rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; color: #fff; background: rgba(22,31,27,.68); font-size: 28rpx; }
.photo-saved { position: absolute; right: 0; bottom: 0; left: 0; padding: 5rpx; color: #fff; text-align: center; background: rgba(23,107,77,.78); font-size: 18rpx; }
.photo-add { display: flex; flex-direction: column; align-items: center; justify-content: center; border: 1rpx dashed #90bdaa; color: #176b4d; background: #f5faf7; }
.photo-add text { font-size: 45rpx; line-height: 1; }
.photo-add view { margin-top: 9rpx; font-size: 20rpx; }
.detail-field { padding: 20rpx 0; }
.detail-field > text { display: block; color: #65746c; font-size: 22rpx; }
.detail-field textarea { width: 100%; height: 150rpx; margin-top: 13rpx; padding: 15rpx; border-radius: 13rpx; background: #f4f7f5; font-size: 24rpx; }
.price-tip { width: calc(100% - 44rpx); margin: 17rpx 22rpx; color: #7d8982; text-align: center; font-size: 20rpx; }
.bottom-bar { position: fixed; right: 0; bottom: 0; left: 0; width: 100%; padding: 17rpx 22rpx 28rpx; background: #fff; box-shadow: 0 -5rpx 20rpx rgba(0,0,0,.07); }
.save-button { height: 78rpx; display: flex; align-items: center; justify-content: center; border-radius: 39rpx; color: #fff; background: #a8c2b7; font-size: 25rpx; font-weight: 700; }
.save-button.active { background: #176b4d; }
